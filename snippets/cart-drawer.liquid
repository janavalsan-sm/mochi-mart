{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content cart-drawer__empty-wrap"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <div class="cart-drawer__empty-emoji">🧸</div>
      <h2
        class="theme-drawer__title cart-drawer__empty-title"
        id="cart-drawer-heading"
      >
        Your cart is empty
      </h2>
      <p class="cart-drawer__empty-subtitle">Let's find something cute!</p>

      <a
        class="button cart-items__empty-button cart-drawer__start-shopping"
        href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
      >
        <span class="button-text">
          Start shopping →
        </span>
      </a>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
      style="height: 100dvh !important; max-height: 100dvh !important; overflow: hidden !important; display: flex !important; flex-direction: column !important; padding: 0 !important; background-color: #fffdfa !important; z-index: 10000; box-shadow: -12px 0 40px rgba(0, 0, 0, 0.12) !important; width: min(440px, 100vw) !important; max-width: 100vw !important;"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
          style="height: 100% !important; max-height: 100% !important; display: flex !important; flex-direction: column !important; overflow: hidden !important; flex: 1 1 auto !important; min-height: 0 !important;"
        >
          {%- if cart.empty? -%}
            <div class="theme-drawer__header">
              <button
                on:click="#cart-drawer/close"
                class="theme-drawer__close-button cart-drawer__close-button--empty"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          {%- else -%}
            {% capture cart_badge_html %}
              <span class="cart-drawer__count-badge">(<span class="cart-drawer__count-red">{{ cart.item_count }}</span>)</span>
            {% endcapture %}
            {% assign cart_drawer_title = 'Your little bag' %}
            {% render 'theme-drawer-header',
              title: cart_drawer_title,
              subtitle: 'Your chosen little finds.',
              drawer_id: 'cart-drawer',
              heading_id: 'cart-drawer-heading',
              title_append: cart_badge_html
            %}
          {%- endif -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
                style="height: 100% !important; max-height: 100% !important; display: flex !important; flex-direction: column !important; overflow: hidden !important; flex: 1 1 auto !important; min-height: 0 !important; background-color: transparent !important;"
              >
                <scroll-hint
                  class="cart-drawer__items"
                  style="flex: 1 1 auto !important; min-height: 0 !important; overflow-y: auto !important; overflow-x: hidden !important; padding: 12px 24px 20px 24px !important; box-sizing: border-box !important;"
                >
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div
                  class="cart-drawer__summary"
                  style="flex-shrink: 0 !important; margin-top: auto !important; position: sticky !important; bottom: 0 !important; z-index: 10 !important; background-color: #fffdfa !important; border-top: 1px solid #f1ece4 !important; padding: 22px 24px 26px 24px !important; box-sizing: border-box !important;"
                >
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

