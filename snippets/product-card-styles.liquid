{%- doc -%}
  Product card layout and visual styles matching Mochi Mart's Lovable aesthetic.
  Applies 28px rounded pill card radius, soft warm drop shadow, pastel blush media background (#FDE8E6),
  Fredoka heading typography, pill badges, and a single circular '+' quick-add button.

  @example
  {% render 'product-card-styles' %}
{%- enddoc -%}

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&family=Fredoka:wght@500;600;700&display=swap');

  :root {
    --blush: #fde8e6;
    --butter: #fde8a5;
    --sage: #dce6d9;
    --sky: #d8e8f8;
    --primary: #d32f2f;
    --foreground: #3b2e28;
    --card-radius: 28px;
  }

  /* ----------------------------------------------------
     Card Container (Matches Lovable .card aesthetic)
     Only applied to the root card component, never nested children
     ---------------------------------------------------- */
  product-card,
  article.card,
  .card:not(product-card *),
  .product-card:not(product-card *) {
    background: #ffffff !important;
    border-radius: var(--card-radius, 28px) !important;
    overflow: hidden !important;
    box-shadow: 0 10px 30px -22px rgba(60, 40, 30, 0.35) !important;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
    display: flex !important;
    flex-direction: column !important;
    position: relative !important;
    height: 100% !important;
    width: 100% !important;
    border: none !important;
    box-sizing: border-box !important;
    text-align: left !important;
  }

  @media screen and (min-width: 750px) and (hover: hover) {
    product-card:hover,
    article.card:hover,
    .card:not(product-card *):hover,
    .product-card:not(product-card *):hover {
      transform: translateY(-4px) !important;
      box-shadow: 0 22px 40px -24px rgba(60, 40, 30, 0.4) !important;
      z-index: 4 !important;
    }
  }

  @media screen and (max-width: 749px) {
    product-card,
    article.card,
    .card,
    .product-card,
    product-card:hover,
    article.card:hover,
    .card:hover,
    .product-card:hover {
      transform: none !important;
    }
  }

  /* Ensure slider containers provide breathing room so card drop shadow and hover lift are never clipped */
  .slider-outer .new-swiper-container,
  .new-swiper-container,
  .swiper.new-swiper-container {
    padding-top: 12px !important;
    padding-bottom: 28px !important;
    margin-top: -12px !important;
    margin-bottom: -28px !important;
    padding-left: 6px !important;
    padding-right: 6px !important;
  }
  .slider-outer .swiper-slide,
  .new-swiper-container .swiper-slide {
    height: auto !important;
    display: flex !important;
    flex-direction: column !important;
    box-sizing: border-box !important;
  }
  .slider-outer .swiper-slide product-card,
  .new-swiper-container .swiper-slide product-card,
  .slider-outer .swiper-slide .resource-list__item,
  .new-swiper-container .swiper-slide .resource-list__item {
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
  }

  /* Prevent any double/extra shadow or border from nested inner card elements */
  product-card .product-card__content,
  product-card .product-grid__card,
  .card .product-card__content,
  .card .product-grid__card,
  product-card-link,
  .product-grid__card,
  .product-card__content {
    box-shadow: none !important;
    border: none !important;
    border-radius: 0 !important;
    transform: none !important;
  }

  /* ----------------------------------------------------
     Media Container with Pastel Blush Background (#FDE8E6)
     ---------------------------------------------------- */
  .card .media,
  article.card .media,
  .product-card .media,
  .product-card .card-gallery,
  .card-gallery,
  .card-gallery slideshow-component,
  .card-gallery slideshow-slides {
    aspect-ratio: 1 / 1 !important;
    background: var(--card-media-bg, var(--blush, #fde8e6)) !important;
    overflow: hidden !important;
    display: block !important;
    position: relative !important;
    width: 100% !important;
    border-radius: var(--card-radius, 28px) var(--card-radius, 28px) 0 0 !important;
  }

  /* ----------------------------------------------------
     Space Between Product Card Image and Details
     (Mobile and Responsive Spacing)
     ---------------------------------------------------- */
  .card .media,
  article.card .media,
  .product-card .media,
  .product-card .card-gallery,
  .card-gallery,
  .product-card-gallery {
    margin-bottom: 12px !important;
  }

  /* Reset inner slideshow elements so they never inherit margin-bottom */
  .card-gallery slideshow-component,
  .card-gallery slideshow-slides {
    margin-bottom: 0 !important;
  }

  @media screen and (max-width: 749px) {
    .card .media,
    article.card .media,
    .product-card .media,
    .product-card .card-gallery,
    .card-gallery,
    .product-card-gallery {
      margin-bottom: 12px !important;
    }
  }

  @media screen and (max-width: 480px) {
    .card .media,
    article.card .media,
    .product-card .media,
    .product-card .card-gallery,
    .card-gallery,
    .product-card-gallery {
      margin-bottom: 10px !important;
    }
  }

  .card .media img,
  .card .media .placeholder-svg,
  article.card .media img,
  article.card .media .placeholder-svg,
  .product-card .card-gallery img,
  .card-gallery img,
  .card-gallery .media img,
  .card-gallery slideshow-slide img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) !important;
    display: block !important;
  }

  @media screen and (min-width: 750px) and (hover: hover) {
    .card:hover .media img,
    article.card:hover .media img,
    product-card:hover .card-gallery img,
    .product-card:hover .card-gallery img,
    product-card:hover .media img {
      transform: scale(1.05) !important;
    }
  }

  @media screen and (max-width: 749px) {
    .card .media img,
    article.card .media img,
    product-card .card-gallery img,
    .product-card .card-gallery img,
    product-card .media img,
    .card:hover .media img,
    article.card:hover .media img,
    product-card:hover .card-gallery img,
    .product-card:hover .card-gallery img,
    product-card:hover .media img {
      transform: none !important;
      transition: none !important;
    }
  }

  /* ----------------------------------------------------
     Floating Badges (Lovable Pill Style)
     ---------------------------------------------------- */
  .product-badges,
  .product-card .product-badges {
    position: absolute !important;
    top: 12px !important;
    left: 12px !important;
    z-index: 5 !important;
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 6px !important;
    pointer-events: none !important;
  }

  .product-badges__badge,
  .badge,
  .card .badge,
  article.card .badge {
    padding: 5px 14px !important;
    border-radius: 999px !important;
    font-size: 12px !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    background: #ffffff !important;
    color: var(--primary, #d32f2f) !important;
    box-shadow: 0 4px 12px rgba(60, 40, 30, 0.12) !important;
    letter-spacing: 0.02em !important;
    font-family: 'DM Sans', system-ui, sans-serif !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: none !important;
    text-transform: capitalize !important;
  }

  .color-custom-badge-sale,
  .badge-sale,
  .card .badge-sale {
    background: var(--primary, #d32f2f) !important;
    color: #ffffff !important;
  }

  .badge-new,
  .card .badge-new {
    background: var(--sage, #dce6d9) !important;
    color: #2f5130 !important;
  }

  .badge-limited,
  .card .badge-limited {
    background: var(--butter, #fde8a5) !important;
    color: #6b5210 !important;
  }

  .color-custom-badge-sold-out,
  .badge-sold,
  .card .badge-sold {
    background: var(--foreground, #3b2e28) !important;
    color: #ffffff !important;
  }

  .badge-bestseller,
  .card .badge-bestseller {
    background: #ffffff !important;
    color: var(--primary, #d32f2f) !important;
  }

  /* ----------------------------------------------------
     Card Body Details
     ---------------------------------------------------- */
  .card .body,
  article.card .body,
  .product-card__content,
  .product-grid__card {
    padding: 14px 16px 18px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    flex: 1 !important;
    background: transparent !important;
    box-sizing: border-box !important;
    width: 100% !important;
    text-align: left !important;
    position: relative !important;
    box-shadow: none !important;
    border: none !important;
  }

  /* Type Label */
  .card .type,
  article.card .type,
  .product-card .type {
    font-size: 12px !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    color: rgba(59, 46, 40, 0.55) !important;
    margin-bottom: 2px !important;
    display: block !important;
    font-family: 'DM Sans', system-ui, sans-serif !important;
    line-height: 1.2 !important;
  }

  /* Prevent Duplicate Zoom-out Title in standard view */
  .product-grid-view-zoom-out--details {
    display: none !important;
  }

  ul[product-grid-view='zoom-out'] .product-grid-view-zoom-out--details {
    display: -webkit-box !important;
  }

  /* Product Title (Fredoka Font) */
  .card h3,
  article.card h3,
  .product-card h3,
  .product-title h3,
  .product-title h3 a,
  .product-card .product-title,
  .product-card [data-block-id*="product_title"],
  .product-card a[ref="productTitleLink"],
  .product-card p[role="heading"],
  .product-title p {
    font-family: 'Fredoka', 'DM Sans', system-ui, sans-serif !important;
    font-size: 17px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    margin: 0 !important;
    color: var(--foreground, #3b2e28) !important;
    display: -webkit-box !important;
    -webkit-box-orient: vertical !important;
    -webkit-line-clamp: 2 !important;
    overflow: hidden !important;
  }

  .card h3 a,
  article.card h3 a,
  .product-card h3 a,
  .product-title a,
  .product-card a[ref="productTitleLink"] {
    color: inherit !important;
    text-decoration: none !important;
    transition: color 0.2s ease !important;
  }

  .card h3 a:hover,
  article.card h3 a:hover,
  .product-card h3 a:hover,
  .product-title a:hover {
    color: var(--primary, #d32f2f) !important;
  }

  /* ----------------------------------------------------
     Bottom Row: Price and Quick-Add Button
     ---------------------------------------------------- */
  .card .price,
  article.card .price,
  .product-card .price,
  product-price,
  .product-price {
    font-family: 'DM Sans', system-ui, sans-serif !important;
    font-weight: 700 !important;
    font-size: 17px !important;
    color: var(--foreground, #3b2e28) !important;
    display: inline-flex !important;
    align-items: baseline !important;
    flex-wrap: wrap !important;
    gap: 4px !important;
    line-height: 1.2 !important;
    margin-top: auto !important;
    padding-right: 50px !important; /* Reserve space so price never overlaps quick add button */
  }

  .card .price s,
  article.card .price s,
  .product-card .price s,
  .product-price s,
  .price__sale s {
    font-weight: 500 !important;
    font-size: 14px !important;
    color: rgba(59, 46, 40, 0.45) !important;
    margin-left: 4px !important;
    text-decoration: line-through !important;
  }

  /* ----------------------------------------------------
     Circular Quick-Add '+' Button (Exact Lovable Style)
     ---------------------------------------------------- */
  /* Hide the duplicate quick-add button inside gallery image */
  .card-gallery quick-add-component {
    display: none !important;
  }

  /* Position only the single card-level quick-add at bottom-right */
  .product-card > .product-card__content > quick-add-component,
  .product-card quick-add-component {
    position: absolute !important;
    right: 14px !important;
    bottom: 14px !important;
    z-index: 6 !important;
    width: 40px !important;
    height: 40px !important;
    pointer-events: auto !important;
    inset: auto 14px 14px auto !important;
  }

  .product-card .quick-add__button,
  .product-card button.quick-add__button,
  .product-card add-to-cart-component button,
  button.quick-add {
    width: 40px !important;
    height: 40px !important;
    min-width: 40px !important;
    max-width: 40px !important;
    border-radius: 999px !important;
    border: 0 !important;
    background: var(--primary, #d32f2f) !important;
    color: #ffffff !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease, box-shadow 0.2s ease !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: 0 4px 12px rgba(211, 47, 47, 0.3) !important;
    opacity: 1 !important;
    overflow: hidden !important;
    position: relative !important;
    font-size: 0 !important;
    -webkit-tap-highlight-color: transparent !important;
    pointer-events: auto !important;
  }

  /* Hide inner text ('Add', 'Choose') and cart SVGs to prevent clipped text like 'Ao' or 'dd' */
  .product-card .quick-add__button *,
  .product-card add-to-cart-component button * {
    display: none !important;
  }

  /* Clean, crisp '+' symbol centered in circle */
  .product-card .quick-add__button::after,
  .product-card add-to-cart-component button::after,
  button.quick-add::after {
    content: '+' !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-size: 26px !important;
    font-weight: 400 !important;
    line-height: 1 !important;
    color: #ffffff !important;
    font-family: system-ui, -apple-system, sans-serif !important;
    position: absolute !important;
    inset: 0 !important;
    margin-top: -2px !important;
  }

  /* Added state: show checkmark feedback */
  .product-card .quick-add__button[data-added='true']::after,
  .product-card add-to-cart-component button[data-added='true']::after,
  button.quick-add[data-added='true']::after {
    content: '✓' !important;
    font-size: 20px !important;
    margin-top: 0 !important;
  }

  .product-card .quick-add__button[data-added='true'],
  .product-card add-to-cart-component button[data-added='true'],
  button.quick-add[data-added='true'] {
    background: #2e7d32 !important;
    box-shadow: 0 4px 12px rgba(46, 125, 50, 0.4) !important;
    transform: scale(1.05) !important;
  }

  @media (min-width: 750px) and (hover: hover) {
    .product-card .quick-add__button:hover,
    .product-card button.quick-add__button:hover,
    .product-card add-to-cart-component button:hover,
    button.quick-add:hover {
      transform: scale(1.1) !important;
      box-shadow: 0 6px 16px rgba(211, 47, 47, 0.45) !important;
      background-color: #ba2828 !important;
    }
  }

  @media (hover: none) {
    .product-card .quick-add__button:hover,
    .product-card button.quick-add__button:hover,
    .product-card add-to-cart-component button:hover,
    button.quick-add:hover {
      transform: none !important;
      background-color: var(--primary, #d32f2f) !important;
      box-shadow: 0 4px 12px rgba(211, 47, 47, 0.3) !important;
    }
  }

  .product-card .quick-add__button:active,
  button.quick-add:active,
  add-to-cart-component button:active {
    transform: scale(0.95) !important;
  }

  .product-card .quick-add__button[disabled],
  button.quick-add[disabled],
  add-to-cart-component button[disabled] {
    background: #cccccc !important;
    cursor: not-allowed !important;
    transform: none !important;
    box-shadow: none !important;
    opacity: 0.7 !important;
  }

  /* ----------------------------------------------------
     Grid and Carousel Items Flex Alignment (Only product grids)
     ---------------------------------------------------- */
  :is(.product-grid__item, .resource-list__item, .prdocut_slider_item, .new-swiper-container .swiper-slide, .product-list .swiper-slide) {
    height: auto !important;
    display: flex !important;
    border: none !important;
    box-shadow: none !important;
    background: transparent !important;
    outline: none !important;
  }

  :is(.product-grid__item, .resource-list__item, .prdocut_slider_item, .new-swiper-container .swiper-slide, .product-list .swiper-slide) product-card {
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
  }

  @media screen and (max-width: 640px) {
    .card .body,
    article.card .body,
    .product-card__content {
      padding: 12px 14px 16px !important;
    }

    .card h3,
    article.card h3,
    .product-card h3,
    .product-title h3,
    .product-card .product-title,
    .product-card [data-block-id*="product_title"],
    .product-card a[ref="productTitleLink"],
    .product-card p[role="heading"],
    .product-title p {
      font-size: 15px !important;
    }

    .card .price,
    article.card .price,
    .product-card .price {
      font-size: 15px !important;
      padding-right: 44px !important;
    }

    .product-card .quick-add__button,
    button.quick-add,
    add-to-cart-component button {
      width: 36px !important;
      height: 36px !important;
      min-width: 36px !important;
      max-width: 36px !important;
    }

    .product-card .quick-add__button::after,
    button.quick-add::after {
      font-size: 22px !important;
    }
  }
{% endstylesheet %}
