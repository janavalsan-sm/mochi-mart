
<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  case section.settings.layout_type
    when 'grid'
      assign classes = 'resource-list--grid'
    when 'carousel'
      assign classes = 'resource-list__carousel'
  endcase

  capture styles
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--resource-list-row-gap-desktop: ' | append: section.settings.rows_gap | append: 'px;'
    echo '--resource-list-columns: repeat(' | append: section.settings.columns | append: ', 1fr);'
    echo '--resource-list-columns-mobile: repeat(' | append: section.settings.mobile_columns | append: ', 1fr);'
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--column-count: ' | append: section.settings.columns | append: ';'
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
  endcapture
%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'quantity-selector-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}
{% render 'resource-list-styles' %}
{% render 'product-recommendations-styles' %}
<product-recommendations
  id="product-recommendations-{{ section.id }}"
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ section.settings.product.id | default: product.id }}"
  data-intent="{{ section.settings.recommendation_type }}"
  data-testid="product-recommendations-section"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="product-recommendations-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  {% liquid
    assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme
    if color_scheme == blank
      assign color_scheme = 'scheme-1'
    endif

    assign has_custom_bg = false
    if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)' and section.settings.background_color != 'transparent'
      unless section.settings.background_color contains '{'
        if section.settings.background_color.alpha != 0
          assign has_custom_bg = true
          render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
        endif
      endunless
    endif
  %}

  <div
    class="section-background color-{{ color_scheme }}{% if has_custom_bg %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      color-{{ color_scheme }}
      {% if has_custom_bg %}color-custom-{{ section.id }}{% endif %}
      section-resource-list
      spacing-style
      gap-style
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      {%  render 'gap-style', value: section.settings.gap %}
      {{ styles }}
    "
  >
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.show_view_all %}
      <div class="product-recommendations__header">
        <div class="product-recommendations__header-content">
          {% if section.settings.eyebrow != blank %}
            <span class="product-recommendations__eyebrow">{{ section.settings.eyebrow }}</span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="product-recommendations__heading">
              {{ section.settings.heading }}
            </h2>
          {% endif %}
        </div>
        {% if section.settings.show_view_all and section.settings.view_all_text != blank %}
          <a
            class="product-recommendations__view-all"
            href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.view_all_text }}
          </a>
        {% endif %}
      </div>
    {% else %}
      <div class="section-resource-list__content">
        {% content_for 'blocks' %}
      </div>
    {% endif %}

    {%- if recommendations.performed or section.settings.product == blank -%}
      {% liquid
        if section.settings.product == blank
          assign products = null
          # Onboarding mode: Show placeholder products
          for i in (1..section.settings.max_products)
            assign products = products | append: ', '
            assign products = products | split: ','
          endfor
        elsif recommendations.performed and recommendations.products_count == 0
          # No recommendations found, pull from catalog
          if section.settings.recommendation_type == 'related'
            assign products = collections.all.products | reject: 'id', section.settings.product.id
          elsif section.settings.recommendation_type == 'complementary'
            # Do not recommend the All collection as complementary products
            assign products = null
          endif

        else
          assign products = recommendations.products
        endif
      %}
      {% capture list_items %}
        {% for product in products limit: section.settings.max_products %}
          <div class="resource-list__item">
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product,
              product_view_context: 'recommendation'
            %}
          </div>
          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endcapture %}

      {% liquid
        # Create an array from the list items to be used in the carousel
        assign slide_content = list_items | strip
        assign slides = slide_content | split: '<!--@list/split-->'

        if products != blank and products.size > 0
          assign has_recommendations = 'true'
        else
          assign has_recommendations = 'false'
        endif
      %}

      {% assign unique_id = 'rec-slider-' | append: section.id | remove: '-' %}
      {% if section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' %}
        <div class="slider-outer">
          <div
            id="new-swiper-{{ unique_id }}"
            class="slider-btn new-swiper-container swiper {{ section.settings.arrow_position | default: 'arrows-bottom' }} {{ section.settings.dots_option | default: 'only-mobile' }} {{ section.settings.arrow_option | default: 'arrow-show-both' }}"
            data-id="{{ unique_id }}"
            data-mobile-slider="true"
            data-desktop-slider="true"
            data-tablet-slider="true"
            data-slides-per-view-desktop="{{ section.settings.slides_per_view_desktop | default: 4 }}"
            data-space-between-desktop="{{ section.settings.space_between_desktop | default: 20 }}"
            data-slides-per-view-laptop="{{ section.settings.slides_per_view_laptop | default: 3 }}"
            data-space-between-laptop="{{ section.settings.space_between_laptop | default: 16 }}"
            data-slides-per-view-tablet="{{ section.settings.slides_per_view_tablet | default: 2.5 }}"
            data-space-between-tablet="{{ section.settings.space_between_tablet | default: 16 }}"
            data-slides-per-view-medium-tablet="{{ section.settings.slides_per_view_medium_tablet | default: 2 }}"
            data-space-between-medium-tablet="{{ section.settings.space_between_medium_tablet | default: 12 }}"
            data-slides-per-view-mobile="{{ section.settings.slides_per_view_mobile | default: 1.5 }}"
            data-space-between-mobile="{{ section.settings.space_between_mobile | default: 12 }}"
            data-arrows-enabled="{{ section.settings.arrows_enabled | default: true }}"
            data-autoplay-enabled="{{ section.settings.autoplay_enabled | default: false }}"
            data-autoplay-delay="{{ section.settings.autoplay_delay | default: 3000 }}"
            data-loop-enabled="{{ section.settings.loop_enabled | default: false }}"
            data-dots-enabled="{{ section.settings.dots_enabled | default: true }}"
          >
            <div id="swiper-wrapper-{{ unique_id }}" class="swiper-wrapper">
              {% for item in slides %}
                {% assign clean_item = item | strip %}
                {% if clean_item != blank %}
                  <div class="swiper-slide">
                    {{ clean_item }}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          {% if section.settings.dots_enabled != false %}
            <div class="pagination-container">
              <div class="swiper-pagination"></div>
            </div>
          {% endif %}

          {% if section.settings.arrows_enabled != false %}
            <span class="swipwer--btn swiper-button-previ" data-swiper-id="{{ unique_id }}">
              {% render 'slider-arrow-left' %}
            </span>
            <span class="swipwer--btn swiper-button-nexts" data-swiper-id="{{ unique_id }}">
              {% render 'slider-arrow-right' %}
            </span>
          {% endif %}
        </div>
      {% else %}
        <div
          class="resource-list resource-list--grid"
          data-testid="resource-list-grid"
          data-has-recommendations="{{ has_recommendations }}"
        >
          {{ list_items }}
        </div>
      {% endif %}
    {%- else -%}
      <div
        class="resource-list resource-list--grid"
      >
        {% for i in (1..section.settings.columns) %}
          <div
            class="product-recommendations__skeleton-item"
            aria-label="{{ 'accessibility.loading_product_recommendations' | t }}"
          ></div>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
</product-recommendations>

<script>
  (function() {
    function initRecSlider() {
      if (typeof window.checkScreenSizeAndInitSwipers === 'function') {
        window.checkScreenSizeAndInitSwipers();
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRecSlider);
    } else {
      setTimeout(initRecSlider, 60);
    }
  })();
</script>

{% stylesheet %}
  .product-recommendations__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
    flex-wrap: wrap;
    width: 100%;
    box-sizing: border-box;
  }

  .product-recommendations__header-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .product-recommendations__eyebrow {
    display: block;
    font-family: 'Fredoka', 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #D32F2F;
    margin-bottom: 8px;
  }

  .product-recommendations__heading {
    font-family: 'Fredoka', 'DM Sans', sans-serif;
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 700;
    color: #2C1E19;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .product-recommendations__view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Fredoka', 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #D32F2F;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: gap 0.2s ease, color 0.2s ease;
    white-space: nowrap;
    margin-bottom: 4px;
  }

  .product-recommendations__view-all:hover {
    gap: 10px;
    color: #B71C1C;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_recommendations",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ONE MORE LITTLE THING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also love"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "Shop all →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "related",
          "label": "t:options.related"
        },
        {
          "value": "complementary",
          "label": "t:options.complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "t:content.complementary_products"
    },
    {
      "type": "header",
      "content": "t:content.cards_layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.layout_style",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "carousel",
          "label": "t:options.carousel"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_slider",
      "label": "Enable Swiper Slider",
      "default": true
    },
    {
      "type": "header",
      "content": "Slider Settings",
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "arrows_enabled",
      "label": "Enable Arrows",
      "default": true,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "arrow_position",
      "options": [
        {
          "value": "arrows-bottom",
          "label": "Bottom"
        },
        {
          "value": "arrows-left-and-right",
          "label": "Left & Right"
        }
      ],
      "default": "arrows-bottom",
      "label": "Arrow Position",
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "arrow_option",
      "options": [
        {
          "value": "arrow-only-mobile",
          "label": "Show Arrows On Mobile"
        },
        {
          "value": "arrow-only-desktop",
          "label": "Show Arrows On Desktop"
        },
        {
          "value": "arrow-show-both",
          "label": "Show Arrows On Both Mobile & Desktop"
        }
      ],
      "default": "arrow-show-both",
      "label": "Show Arrows",
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "dots_enabled",
      "label": "Enable Dots",
      "default": true,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "select",
      "id": "dots_option",
      "options": [
        {
          "value": "only-mobile",
          "label": "Show Dots On Mobile"
        },
        {
          "value": "only-desktop",
          "label": "Show Dots On Desktop"
        },
        {
          "value": "show-both",
          "label": "Show Dots On Both Mobile & Desktop"
        }
      ],
      "default": "only-mobile",
      "label": "Show Dots",
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "autoplay_enabled",
      "label": "Autoplay Enabled",
      "default": false,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (ms)",
      "min": 1000,
      "max": 9000,
      "step": 100,
      "default": 3000,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "loop_enabled",
      "label": "Enable Loop",
      "default": false,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "Column Counts",
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "label": "Desktop Items Per View",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_laptop",
      "label": "Laptop Items Per View",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_tablet",
      "label": "Tablet Items Per View",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 2.5,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_medium_tablet",
      "label": "Medium Tablet Items Per View",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 2,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_mobile",
      "label": "Mobile Items Per View",
      "min": 1,
      "max": 10,
      "step": 0.1,
      "default": 1.5,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "Column Spaces",
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "space_between_desktop",
      "label": "Desktop Space Between Items",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "space_between_laptop",
      "label": "Laptop Space Between Items",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "space_between_tablet",
      "label": "Tablet Space Between Items",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 16,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "space_between_medium_tablet",
      "label": "Medium Tablet Space Between Items",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 12,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "space_between_mobile",
      "label": "Mobile Space Between Items",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 12,
      "visible_if": "{{ section.settings.enable_custom_slider == true or section.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "t:settings.carousel_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
