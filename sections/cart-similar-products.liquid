{% assign unique_id = 'new-slider-' | append: section.id %}

{% liquid
  assign max_items = section.settings.max_products
%}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    section-resource-list
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  <div class="section-resource-list__header">
    {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
  </div>

  {% capture list_items %}
    {% assign max_items = section.settings.max_products_to_show | default: 8 %}
    {% assign items_rendered = 0 %}
    
    {% if cart.item_count > 0 %}
      {% assign cart_product_handles = ',' %}
      {% for item in cart.items %}
        {% assign cart_product_handles = cart_product_handles | append: item.product.handle | append: ',' %}
      {% endfor %}
      
      {% assign displayed_handles = ',' %}
      
      {% # First round: Take first collection from each cart product %}
      {% for item in cart.items %}
        {% assign product = item.product %}
        {% if product.collections.size > 0 %}
          {% assign first_collection = product.collections.first %}
          {% if first_collection and first_collection.products_count > 0 %}
            {% for collection_product in first_collection.products %}
              {% assign check_handle = ',' | append: collection_product.handle | append: ',' %}
              {% unless cart_product_handles contains check_handle or displayed_handles contains check_handle %}
                {% assign displayed_handles = displayed_handles | append: collection_product.handle | append: ',' %}
                {% assign items_rendered = items_rendered | plus: 1 %}
                <div class="resource-list__item">
                  {% # theme-check-disable UniqueStaticBlockId %}
                    {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: collection_product %}
                  {% # theme-check-enable UniqueStaticBlockId %}
                </div>
                <!--@list/split-->
                {% if items_rendered >= max_items %}
                  {% break %}
                {% endif %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endif %}
        {% if items_rendered >= max_items %}
          {% break %}
        {% endif %}
      {% endfor %}
      
      {% # Subsequent rounds: If we need more products, go to next collections %}
      {% if items_rendered < max_items %}
        {% for collection_round in (1..10) %}
          {% assign products_added_this_round = 0 %}
          {% for item in cart.items %}
            {% assign product = item.product %}
            {% if product.collections.size > collection_round %}
              {% assign current_collection = product.collections[collection_round] %}
              {% if current_collection and current_collection.products_count > 0 %}
                {% for collection_product in current_collection.products %}
                  {% assign check_handle = ',' | append: collection_product.handle | append: ',' %}
                  {% unless cart_product_handles contains check_handle or displayed_handles contains check_handle %}
                    {% assign displayed_handles = displayed_handles | append: collection_product.handle | append: ',' %}
                    {% assign items_rendered = items_rendered | plus: 1 %}
                    {% assign products_added_this_round = products_added_this_round | plus: 1 %}
                    <div class="resource-list__item">
                      {% # theme-check-disable UniqueStaticBlockId %}
                        {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: collection_product %}
                      {% # theme-check-enable UniqueStaticBlockId %}
                    </div>
                    <!--@list/split-->
                    {% if items_rendered >= max_items %}
                      {% break %}
                    {% endif %}
                  {% endunless %}
                {% endfor %}
              {% endif %}
            {% endif %}
            {% if items_rendered >= max_items %}
              {% break %}
            {% endif %}
          {% endfor %}
          {% if products_added_this_round == 0 or items_rendered >= max_items %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% endif %}
      
      {% # Final fallback: If we still don't have enough products, use all products %}
      {% if items_rendered < max_items %}
        {% for product in collections.all.products %}
          {% assign check_handle = ',' | append: product.handle | append: ',' %}
          {% unless cart_product_handles contains check_handle or displayed_handles contains check_handle %}
            {% assign displayed_handles = displayed_handles | append: product.handle | append: ',' %}
            {% assign items_rendered = items_rendered | plus: 1 %}
            <div class="resource-list__item">
              {% # theme-check-disable UniqueStaticBlockId %}
                {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
              {% # theme-check-enable UniqueStaticBlockId %}
            </div>
            <!--@list/split-->
            {% if items_rendered >= max_items %}
              {% break %}
            {% endif %}
          {% endunless %}
        {% endfor %}
      {% endif %}
      
    {% else %}
      {% # Empty cart - show featured products %}
      {% assign featured_collection = collections.all %}
      {% if featured_collection and featured_collection.products_count > 0 %}
        {% for product in featured_collection.products limit: max_items %}
          <div class="resource-list__item">
            {% # theme-check-disable UniqueStaticBlockId %}
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: product %}
            {% # theme-check-enable UniqueStaticBlockId %}
          </div>
          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% else %}
        {% # Fallback to placeholder products %}
        {% for i in (1..max_items) %}
          <div class="resource-list__item">
            {% # theme-check-disable UniqueStaticBlockId %}
              {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
            {% # theme-check-enable UniqueStaticBlockId %}
          </div>
          {% unless forloop.last %}
            <!--@list/split-->
          {% endunless %}
        {% endfor %}
      {% endif %}
    {% endif %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% if section.settings.enable_custom_slider == true and section.settings.layout_type == "carousel" %}
    <div class="slider-outer">
      <div
        id="new-swiper-{{ unique_id }}"
        class="slider-btn new-swiper-container swiper {{ section.settings.arrow_position }} {{ section.settings.dots_option }} {{ section.settings.arrow_option }}"
        data-id="{{ unique_id }}"
        data-mobile-slider="true"
        data-desktop-slider="true"
        data-slides-per-view-desktop="{{ section.settings.slides_per_view_desktop }}"
        data-space-between-desktop="{{ section.settings.space_between_desktop }}"
        data-slides-per-view-laptop="{{ section.settings.slides_per_view_laptop }}"
        data-space-between-laptop="{{ section.settings.space_between_laptop }}"
        data-slides-per-view-tablet="{{ section.settings.slides_per_view_tablet }}"
        data-space-between-tablet="{{ section.settings.space_between_tablet }}"
        data-slides-per-view-medium-tablet="{{ section.settings.slides_per_view_medium_tablet }}"
        data-space-between-medium-tablet="{{ section.settings.space_between_medium_tablet }}"
        data-slides-per-view-mobile="{{ section.settings.slides_per_view_mobile }}"
        data-space-between-mobile="{{ section.settings.space_between_mobile }}"
        data-arrows-enabled="{{ section.settings.arrows_enabled }}"
        data-autoplay-enabled="{{ section.settings.autoplay_enabled }}"
        data-autoplay-delay="{{ section.settings.autoplay_delay }}"
        data-loop-enabled="{{ section.settings.loop_enabled }}"
        data-dots-enabled="{{ section.settings.dots_enabled }}"
      >
        <div id="swiper-wrapper-{{ unique_id }}" class="swiper-wrapper">
          {% for item in list_items_array %}
            {% assign clean_item = item | strip %}
            {% if clean_item != blank %}
              <div class="swiper-slide">
                {{ clean_item }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      
      {% if section.settings.dots_enabled %}
        <div class="pagination-container">
          <div class="swiper-pagination"></div>
        </div>
      {% endif %}
      
      {% if section.settings.arrows_enabled %}
        <span class="swipwer--btn swiper-button-previ" data-swiper-id="{{ unique_id }}">
          {% render 'slider-arrow-left' %}
        </span>
        <span class="swipwer--btn swiper-button-nexts" data-swiper-id="{{ unique_id }}">
          {% render 'slider-arrow-right' %}
        </span>
      {% endif %}
    </div>
  {% else %}
    {% render 'resource-list',
      list_items: list_items,
      list_items_array: list_items_array,
      settings: section.settings,
      slide_count: max_items,
      content_type: 'products',
      test_id: 'resource-list-grid'
    %}
  {% endif %}
  
  <div
    class="section-resource-list__content"
    style="--horizontal-alignment: {{ section.settings.horizontal_alignment }};"
  >
    {%- content_for 'blocks' -%}
  </div>
</div>

<script src="{{ 'arrow-out-slider.js' | asset_url }}" defer="defer"></script>
{% schema %}
