            "type": "checkbox",
            "id": "arrows_enabled",
            "label": "Enable Arrows",
            "default": true,
          "visible_if": "{{ section.settings.enable_custom_slider == true }}"
        },
         {
            "type": "select",
            "id": "arrow_position",
