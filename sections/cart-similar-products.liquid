        },
        {
            "type": "range",
            "id": "space_between_laptop",
            "label": "Laptop Space Between Items",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 20,
          "visible_if": "{{ section.settings.enable_custom_slider == true }}"
        },
        {
            "type": "range",
            "id": "space_between_tablet",
            "label": "Tablet Space Between Items",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 20,
          "visible_if": "{{ section.settings.enable_custom_slider == true }}"
        },
        {
            "type": "range",
            "id": "space_between_medium_tablet",
            "label": "Medium Tablet Space Between Items",
            "min": 0,
            "max": 100,
            "step": 1,
            "default": 20,
          "visible_if": "{{ section.settings.enable_custom_slider == true }}"
        },
        {
            "type": "range",
            "id": "space_between_mobile",
            "label": "Mobile Space Between Items",
            "min": 0,
