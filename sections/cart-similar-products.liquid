                {
                    "value": "arrow-only-mobile",
                    "label": "Show Arrows On Mobile"
                },
                {
                    "value": "arrow-only-desktop",
                    "label": "Show Arrows On Desktop"
                },
                {
                    "value": "arrow-show-both",
                    "label": "Show Arrows On Both Mobile & Desktop"
                }
            ],
            "default": "arrow-only-desktop",
            "label": "Show Arrows",
          "visible_if": "{{ section.settings.enable_custom_slider == true }}"
        },
        {
            "type": "checkbox",
            "id": "dots_enabled",
            "label": "Enable Dot",
            "default": true,
          "visible_if": "{{ section.settings.enable_custom_slider == true }}"
        },
        {
            "type": "select",
            "id": "dots_option",
            "options": [
                {
                    "value": "only-mobile",
                    "label": "Show Dots On Mobile"
                },
                {
                    "value": "only-desktop",
                    "label": "Show Dots On Desktop"
                },
                {
                    "value": "show-both",
                    "label": "Show Dots On Both Mobile & Desktop"
                }
            ],
            "default": "only-mobile",
            "label": "Show Dots",
          "visible_if": "{{ section.settings.enable_custom_slider == true }}"
        },
        {
            "type": "checkbox",
