{% liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme
  if color_scheme == blank
    assign color_scheme = 'scheme-1'
  endif

  assign has_custom_bg = false
  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)' and section.settings.custom_bg_color != 'transparent'
    assign has_custom_bg = true
    render 'contrast-override', background_color: section.settings.custom_bg_color, section_id: section.id
  endif
%}

<div
  class="features-bar-section features-bar--{{ section.id }} color-{{ color_scheme }}{% if has_custom_bg %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- if has_custom_bg -%}
      --features-bar-bg: {{ section.settings.custom_bg_color }};
    {%- else -%}
      --features-bar-bg: var(--color-background);
    {%- endif -%}
    --features-bar-icon-color: {{ section.settings.icon_color | default: '#d32f2f' }};
    {%- if section.settings.text_color != blank -%}
      --features-bar-text-color: {{ section.settings.text_color }};
    {%- else -%}
      --features-bar-text-color: var(--color-foreground);
    {%- endif -%}
    --features-bar-border-color: {{ section.settings.border_color | default: '#f0ece4' }};
    --features-bar-pt: {{ section.settings.padding_top }}px;
    --features-bar-pb: {{ section.settings.padding_bottom }}px;
    --features-bar-icon-size: {{ section.settings.icon_size }}px;
    --features-bar-font-size: {{ section.settings.font_size }}px;
    --features-marquee-speed: {{ section.settings.marquee_speed | default: 22 }}s;
    --features-marquee-gap: {{ section.settings.marquee_gap | default: 36 }}px;
  "
>
  <div class="features-bar__wrapper features-bar__wrapper--{{ section.settings.section_width }}">
    {%- capture items_markup -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign item_has_link = false
          if block.settings.link != blank
            assign item_has_link = true
          endif
        -%}
        <div class="features-bar__item" {{ block.shopify_attributes }}>
          {%- if item_has_link -%}
            <a href="{{ block.settings.link }}" class="features-bar__item-link">
          {%- else -%}
            <div class="features-bar__item-inner">
          {%- endif -%}

            <div class="features-bar__icon-wrap">
              {%- if block.settings.custom_icon != blank -%}
                {{
                  block.settings.custom_icon
                  | image_url: width: 60
                  | image_tag:
                    loading: 'lazy',
                    class: 'features-bar__custom-icon',
                    alt: block.settings.text | escape
                }}
              {%- else -%}
                {%- case block.settings.icon -%}
                  {%- when 'truck' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 18H3c-.6 0-1-.4-1-1V7c0-.6.4-1 1-1h10c.6 0 1 .4 1 1v11"/>
                      <path d="M14 9h4l4 4v4c0 .6-.4 1-1 1h-2"/>
                      <circle cx="7" cy="18" r="2"/>
                      <circle cx="17" cy="18" r="2"/>
                      <path d="M9 18h6"/>
                    </svg>
                  {%- when 'gift' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="8" width="18" height="4" rx="1"/>
                      <path d="M12 8v13"/>
                      <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/>
                      <path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 4.8 0 0 1 12 8a4.8 4.8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/>
                    </svg>
                  {%- when 'package_check' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m16 16 2 2 4-4"/>
                      <path d="M21 10V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"/>
                      <path d="m7.5 4.27 9 5.15"/>
                      <polyline points="3.29 7 12 12 20.71 7"/>
                      <line x1="12" y1="12" x2="12" y2="22"/>
                    </svg>
                  {%- when 'heart' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
                    </svg>
                  {%- when 'sparkles' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>
                    </svg>
                  {%- when 'star' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  {%- when 'shield_check' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                      <path d="m9 12 2 2 4-4"/>
                    </svg>
                  {%- when 'return' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                      <path d="M3 3v5h5"/>
                    </svg>
                  {%- when 'smile' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/>
                      <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
                      <line x1="9" x2="9.01" y1="9" y2="9"/>
                      <line x1="15" x2="15.01" y1="9" y2="9"/>
                    </svg>
                  {%- when 'clock' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>
                  {%- when 'tag' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/>
                      <circle cx="7" cy="7" r=".5" fill="currentColor"/>
                    </svg>
                  {%- when 'sun' -%}
                    <svg class="features-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="4"/>
                      <path d="M12 2v2"/>
                      <path d="M12 20v2"/>
                      <path d="m4.93 4.93 1.41 1.41"/>
                      <path d="m17.66 17.66 1.41 1.41"/>
                      <path d="M2 12h2"/>
                      <path d="M20 12h2"/>
                      <path d="m6.34 17.66-1.41 1.41"/>
                      <path d="m19.07 4.93-1.41 1.41"/>
                    </svg>
                {%- endcase -%}
              {%- endif -%}
            </div>

            {%- if block.settings.text != blank -%}
              <div class="features-bar__text">
                {{ block.settings.text }}
              </div>
            {%- endif -%}

          {%- if item_has_link -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endcapture -%}

    {%- if section.settings.marquee_desktop -%}
      {%- comment -%} Desktop & Mobile both Marquee {%- endcomment -%}
      <div class="features-bar__marquee-container features-bar__marquee-container--active">
        <div class="features-bar__marquee-track">
          <div class="features-bar__marquee-group">
            {{ items_markup }}
          </div>
          <div class="features-bar__marquee-group" aria-hidden="true">
            {{ items_markup }}
          </div>
        </div>
      </div>
    {%- else -%}
      {%- comment -%} Desktop static row {%- endcomment -%}
      <div class="features-bar__items-desktop">
        {{ items_markup }}
      </div>

      {%- comment -%} Mobile Marquee float {%- endcomment -%}
      <div class="features-bar__marquee-container features-bar__marquee-container--mobile-only">
        <div class="features-bar__marquee-track">
          <div class="features-bar__marquee-group">
            {{ items_markup }}
          </div>
          <div class="features-bar__marquee-group" aria-hidden="true">
            {{ items_markup }}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .shopify-section:has(.features-bar--{{ section.id }}) {
    position: relative;
    isolation: isolate;
  }
  .features-bar--{{ section.id }} {
    background-color: var(--features-bar-bg) !important;
    color: var(--features-bar-text-color);
    padding-top: var(--features-bar-pt);
    padding-bottom: var(--features-bar-pb);
    font-family: var(--font-body--family, "DM Sans", -apple-system, BlinkMacSystemFont, sans-serif);
    {%- if section.settings.show_top_border -%}
      border-top: 1px solid var(--features-bar-border-color);
    {%- endif -%}
    {%- if section.settings.show_bottom_border -%}
      border-bottom: 1px solid var(--features-bar-border-color);
    {%- endif -%}
    position: relative;
    z-index: 2;
    overflow: hidden;
  }

  .features-bar--{{ section.id }} .features-bar__wrapper--page-width {
    max-width: var(--page-width, 1320px);
    margin: 0 auto;
    padding: 0 20px;
  }

  .features-bar--{{ section.id }} .features-bar__wrapper--full-width {
    width: 100%;
    padding: 0 24px;
  }

  @media (min-width: 768px) {
    .features-bar--{{ section.id }} .features-bar__wrapper--page-width {
      padding: 0 32px;
    }
  }

  /* Desktop Static Row */
  .features-bar--{{ section.id }} .features-bar__items-desktop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }

  .features-bar--{{ section.id }} .features-bar__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    flex-shrink: 0;
  }

  .features-bar--{{ section.id }} .features-bar__item-inner,
  .features-bar--{{ section.id }} .features-bar__item-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .features-bar--{{ section.id }} .features-bar__item-link:hover {
    opacity: 0.8;
    transform: translateY(-1px);
  }

  .features-bar--{{ section.id }} .features-bar__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--features-bar-icon-color);
    width: var(--features-bar-icon-size);
    height: var(--features-bar-icon-size);
  }

  .features-bar--{{ section.id }} .features-bar__svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
    display: block;
  }

  .features-bar--{{ section.id }} .features-bar__custom-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .features-bar--{{ section.id }} .features-bar__text {
    font-size: var(--features-bar-font-size);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: inherit;
    white-space: nowrap;
  }

  .features-bar--{{ section.id }} .features-bar__text p {
    margin: 0;
    display: inline;
  }

  .features-bar--{{ section.id }} .features-bar__text strong,
  .features-bar--{{ section.id }} .features-bar__text b {
    font-weight: 600;
  }

  /* Marquee Floating Animation */
  .features-bar--{{ section.id }} .features-bar__marquee-container {
    overflow: hidden;
    width: 100%;
    position: relative;
    mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 4%, black 96%, transparent);
  }

  .features-bar--{{ section.id }} .features-bar__marquee-container--active {
    display: block;
  }

  .features-bar--{{ section.id }} .features-bar__marquee-container--mobile-only {
    display: none;
  }

  .features-bar--{{ section.id }} .features-bar__marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: featuresBarMarquee--{{ section.id }} var(--features-marquee-speed) linear infinite;
  }

  {%- if section.settings.pause_on_hover -%}
  .features-bar--{{ section.id }} .features-bar__marquee-track:hover {
    animation-play-state: paused;
  }
  {%- endif -%}

  .features-bar--{{ section.id }} .features-bar__marquee-group {
    display: flex;
    align-items: center;
    gap: var(--features-marquee-gap);
    padding-right: var(--features-marquee-gap);
    flex-shrink: 0;
  }

  .features-bar--{{ section.id }} .features-bar__marquee-group .features-bar__item {
    flex: 0 0 auto;
  }

  @keyframes featuresBarMarquee--{{ section.id }} {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Responsive behavior */
  @media (max-width: 989px) {
    .features-bar--{{ section.id }} .features-bar__items-desktop {
      display: none !important;
    }
    .features-bar--{{ section.id }} .features-bar__marquee-container--mobile-only {
      display: block !important;
    }
    .features-bar--{{ section.id }} .features-bar__text {
      font-size: calc(var(--features-bar-font-size) - 0.5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .features-bar--{{ section.id }} .features-bar__marquee-track {
      animation: none;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
</style>

{% schema %}
{
  "name": "Features bar",
  "tag": "section",
  "class": "features-bar-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "checkbox",
      "id": "marquee_desktop",
      "label": "Enable marquee floating on desktop as well",
      "info": "On mobile, it always floats smoothly like a marquee instead of a grid.",
      "default": false
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee scroll duration (lower = faster)",
      "min": 10,
      "max": 50,
      "step": 2,
      "unit": "s",
      "default": 22
    },
    {
      "type": "range",
      "id": "marquee_gap",
      "label": "Space between marquee items",
      "min": 20,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause marquee on hover/touch",
      "default": true
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "header",
      "content": "Colors & Borders"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom background color",
      "info": "Leave blank to inherit from color scheme"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#d32f2f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave blank to inherit from color scheme"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#f0ece4"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Truck / Free shipping"
            },
            {
              "value": "gift",
              "label": "Gift box"
            },
            {
              "value": "package_check",
              "label": "Package check / Delight"
            },
            {
              "value": "heart",
              "label": "Heart / Happy moments"
            },
            {
              "value": "sparkles",
              "label": "Sparkles / Magic"
            },
            {
              "value": "star",
              "label": "Star / Top rated"
            },
            {
              "value": "shield_check",
              "label": "Shield check / Guarantee"
            },
            {
              "value": "return",
              "label": "Return / Exchange"
            },
            {
              "value": "smile",
              "label": "Smile / Joy"
            },
            {
              "value": "clock",
              "label": "Clock / Fast delivery"
            },
            {
              "value": "tag",
              "label": "Tag / Offers"
            },
            {
              "value": "sun",
              "label": "Sun / Everyday"
            }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon image",
          "info": "Overrides the selected icon. PNG or SVG recommended."
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Free shipping offer: over ₹999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features bar",
      "category": "Trust & Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "truck",
            "text": "Preview shipping offer: over ₹999"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "gift",
            "text": "Gift-worthy finds"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "package_check",
            "text": "Made to delight"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "heart",
            "text": "Made for happy moments"
          }
        }
      ]
    }
  ]
}
{% endschema %}
