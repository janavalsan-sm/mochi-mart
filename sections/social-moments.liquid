{%- comment -%}
  Social Moments / Instagram Feed Section — Mochi Mart
  Renders a soft curved panel with 6 product/social imagery tiles, an Instagram CTA,
  and the animated bobbing mascot doll character from Lovable.
{%- endcomment -%}

{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme
  if color_scheme == blank
    assign color_scheme = 'scheme-1'
  endif
-%}

<div
  class="social-moments-section color-{{ color_scheme }}"
  id="SocialMoments-{{ section.id }}"
  style="
    --sm-bg: {{ section.settings.panel_bg_color | default: '#ffe8ec' }};
    --sm-pt: {{ section.settings.padding_top }}px;
    --sm-pb: {{ section.settings.padding_bottom }}px;
    --sm-radius: {{ section.settings.panel_radius }}px;
    --sm-eyebrow-color: {{ section.settings.eyebrow_color | default: '#d32f2f' }};
    --sm-heading-color: {{ section.settings.heading_color | default: '#2c221e' }};
    --sm-heading-size: {{ section.settings.heading_size }}px;
    --sm-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --sm-link-color: {{ section.settings.link_color | default: '#d32f2f' }};
    --sm-caption-color: {{ section.settings.caption_color | default: '#78716c' }};
    --sm-mascot-width: {{ section.settings.mascot_width }}px;
  "
>
  <div class="social-moments__outer">
    <div class="social-moments__panel">
      {%- comment -%} Header {%- endcomment -%}
      <div class="social-moments__header">
        <div class="social-moments__header-left">
          {%- if section.settings.eyebrow != blank -%}
            <div class="social-moments__eyebrow">
              {{ section.settings.eyebrow }}
            </div>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="social-moments__heading">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
        </div>

        {%- if section.settings.link_text != blank -%}
          <div class="social-moments__header-right">
            <a
              href="{{ section.settings.link_url | default: 'https://instagram.com/' }}"
              target="_blank"
              rel="noopener noreferrer"
              class="social-moments__link"
            >
              <span>{{ section.settings.link_text }}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Grid of image cards {%- endcomment -%}
      <div class="social-moments__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_link = false
            if block.settings.link != blank
              assign has_link = true
            endif
          -%}
          <div class="social-moments__tile" {{ block.shopify_attributes }}>
            {%- if has_link -%}
              <a href="{{ block.settings.link }}" class="social-moments__tile-link">
            {%- else -%}
              <div class="social-moments__tile-inner">
            {%- endif -%}

              <div class="social-moments__tile-media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      class: 'social-moments__tile-img',
                      alt: block.settings.alt_text | default: section.settings.heading | escape
                  }}
                {%- elsif block.settings.fallback_image != blank -%}
                  <img
                    src="{{ block.settings.fallback_image | asset_url }}"
                    alt="{{ block.settings.alt_text | default: 'Mochi Mart Moment' | escape }}"
                    loading="lazy"
                    class="social-moments__tile-img"
                    width="400"
                    height="400"
                  >
                {%- else -%}
                  <img
                    src="{{ 'cat-1.jpg' | asset_url }}"
                    alt="Mochi Mart Moment"
                    loading="lazy"
                    class="social-moments__tile-img"
                    width="400"
                    height="400"
                  >
                {%- endif -%}
              </div>

            {%- if has_link -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Caption note {%- endcomment -%}
      {%- if section.settings.caption != blank -%}
        <div class="social-moments__caption">
          {{ section.settings.caption }}
        </div>
      {%- endif -%}

      {%- comment -%} Mascot Doll Character {%- endcomment -%}
      {%- if section.settings.show_mascot -%}
        <div class="social-moments__mascot-wrapper">
          {%- if section.settings.mascot_image != blank -%}
            {{
              section.settings.mascot_image
              | image_url: width: 300
              | image_tag:
                loading: 'lazy',
                class: 'social-moments__mascot mascot-peek',
                alt: 'Mochi Mascot'
            }}
          {%- else -%}
            <img
              src="{{ 'mascot.png' | asset_url }}"
              alt="Mochi Mascot"
              loading="lazy"
              class="social-moments__mascot mascot-peek"
              width="140"
              height="140"
            >
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .social-moments-section {
    padding-top: var(--sm-pt);
    padding-bottom: var(--sm-pb);
    font-family: var(--font-body--family, "DM Sans", -apple-system, BlinkMacSystemFont, sans-serif);
    position: relative;
    overflow: visible;
  }

  .social-moments__outer {
    max-width: var(--page-width, 1360px);
    margin: 0 auto;
    padding: 0 16px;
    position: relative;
    overflow: visible;
  }

  @media (min-width: 768px) {
    .social-moments__outer {
      padding: 0 24px;
    }
  }

  /* Soft Curved Panel */
  .social-moments__panel {
    background-color: var(--sm-bg);
    border-radius: var(--sm-radius);
    padding: 70px 36px;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  @media (max-width: 767px) {
    .social-moments__panel {
      padding: 30px 20px;
      border-radius: 28px;
    }
  }

  /* Header */
  .social-moments__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .social-moments__header-left {
    flex: 1 1 auto;
  }

  .social-moments__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sm-eyebrow-color);
    margin-bottom: 10px;
  }

  .social-moments__heading {
    font-family: var(--font-heading--family, "Fredoka", "DM Sans", sans-serif);
    font-size: var(--sm-heading-size);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--sm-heading-color);
    margin: 0;
  }

  @media (max-width: 767px) {
    .social-moments__heading {
      font-size: var(--sm-heading-size-mobile);
    }
    .social-moments__header {
      margin-bottom: 20px;
    }
  }

  .social-moments__header-right {
    flex-shrink: 0;
  }

  .social-moments__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
    color: var(--sm-link-color);
    text-decoration: none;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .social-moments__link:hover {
    opacity: 0.85;
    text-decoration: underline;
    transform: translateX(2px);
  }

  .social-moments__link svg {
    transition: transform 0.2s ease;
  }

  .social-moments__link:hover svg {
    transform: translateX(3px);
  }

  /* Grid of tiles */
  .social-moments__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
    width: 100%;
  }

  .social-moments__tile {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 4px 16px -8px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
  }

  .social-moments__tile:hover {
    transform: translateY(-4px) rotate(-1deg);
    box-shadow: 0 12px 28px -8px rgba(0, 0, 0, 0.14);
  }

  .social-moments__tile-link,
  .social-moments__tile-inner {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .social-moments__tile-media {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .social-moments__tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .social-moments__tile:hover .social-moments__tile-img {
    transform: scale(1.04);
  }

  @media (max-width: 1024px) {
    .social-moments__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
  }

  @media (max-width: 600px) {
    .social-moments__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }
    .social-moments__tile {
      border-radius: 16px;
    }
  }

  @media (max-width: 420px) {
    .social-moments__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }

  /* Caption */
  .social-moments__caption {
    margin-top: 22px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--sm-caption-color);
    max-width: 80%;
  }

  .social-moments__caption p {
    margin: 0;
  }

  /* Animated Mascot Doll — Exact mascot-peek movement from Lovable */
  .social-moments__mascot-wrapper {
    position: absolute;
    right: 28px;
    bottom: 0;
    width: var(--sm-mascot-width);
    z-index: 10;
    pointer-events: none;
    line-height: 0;
  }

  .social-moments__mascot {
    width: 100%;
    height: auto;
    display: block;
  }

  .mascot-peek {
    animation: 6s ease-in-out infinite mascot-peek;
    will-change: transform;
  }

  @keyframes mascot-peek {
    0%, 15%, 100% {
      transform: translateY(70%);
    }
    35%, 65% {
      transform: translateY(0);
    }
  }

  .mascot-bob {
    animation: bob 3s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @media (max-width: 767px) {
    .social-moments__mascot-wrapper {
      right: 12px;
      bottom: 0;
      width: calc(var(--sm-mascot-width) * 0.75);
    }
    .social-moments__caption {
      max-width: 68%;
      font-size: 11.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mascot-peek,
    .mascot-bob,
    .social-moments__mascot {
      animation: none;
    }
    .social-moments__tile:hover {
      transform: none;
    }
  }
</style>

{% schema %}
{
  "name": "Social moments",
  "tag": "section",
  "class": "social-moments-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Headings & Link"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small eyebrow text",
      "default": "THE LITTLE MOMENTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow @mochi_mart_"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (Desktop)",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (Mobile)",
      "min": 20,
      "max": 38,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Find us on Instagram"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Instagram profile link"
    },
    {
      "type": "inline_richtext",
      "id": "caption",
      "label": "Bottom caption note",
      "default": "A peek at our little world — preview product imagery, not Instagram posts."
    },
    {
      "type": "header",
      "content": "Animated Mascot Doll"
    },
    {
      "type": "checkbox",
      "id": "show_mascot",
      "label": "Show animated bobbing mascot",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "mascot_image",
      "label": "Custom mascot image",
      "info": "Leave empty to use the default cute mascot"
    },
    {
      "type": "range",
      "id": "mascot_width",
      "label": "Mascot width",
      "min": 70,
      "max": 180,
      "step": 5,
      "unit": "px",
      "default": 115
    },
    {
      "type": "header",
      "content": "Panel Styling & Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "panel_bg_color",
      "label": "Panel background color",
      "default": "#ffe8ec"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Panel corner radius",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow text color",
      "default": "#d32f2f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text color",
      "default": "#2c221e"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#d32f2f"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption text color",
      "default": "#78716c"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Social Moment Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "fallback_image",
          "label": "Theme asset fallback filename",
          "default": "cat-1.jpg"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text",
          "default": "Cute stationery find"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tile link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social moments",
      "category": "Social proof",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "fallback_image": "cat-1.jpg",
            "alt_text": "Cute crystal pens"
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "cat-2.jpg",
            "alt_text": "Bunny and cat pens"
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "cat-3.jpg",
            "alt_text": "Pink fluffy plush"
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "cat-4.jpg",
            "alt_text": "Pink gift set box"
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "cat-5.jpg",
            "alt_text": "Hooded bunny plush"
          }
        },
        {
          "type": "image",
          "settings": {
            "fallback_image": "cat-6.jpg",
            "alt_text": "Pastel washi tape & stickers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
