{% assign unique_id = 'product-list-' | append: section.id %}
{{ 'slider-styles.css' | asset_url | stylesheet_tag }}

{% liquid
  assign max_items = section.settings.max_products | default: 8
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'quantity-selector-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}
{% render 'resource-list-styles' %}
{% render 'product-card-styles' %}
{% render 'price-styles' %}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="
    section
    featured-collection-section
    section--{{ section.settings.section_width }}
    {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
    spacing-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %};
    --desktop-columns: {{ section.settings.columns | default: 4 }};
    --laptop-columns: {{ section.settings.columns_laptop | default: 3 }};
    --tablet-columns: {{ section.settings.columns_tablet | default: 2 }};
    --mobile-columns: {{ section.settings.mobile_columns | default: 2 }};
    --desktop-col-gap: {{ section.settings.slide_columns_gap | default: 16 }}px;
    --desktop-row-gap: {{ section.settings.slide_row_gap | default: 24 }}px;
    --mobile-col-gap: {{ section.settings.slide_mobile_columns_gap | default: 12 }}px;
    --mobile-row-gap: {{ section.settings.slide_mobile_row_gap | default: 16 }}px;
  "
>
  {%- comment -%} Section Header (Direct Section Settings) {%- endcomment -%}
  {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank or section.settings.show_view_all %}
    <div class="featured-collection__header featured-collection__header--{{ section.settings.header_alignment | default: 'left' }}">
      <div class="featured-collection__header-content">
        {% if section.settings.eyebrow != blank %}
          <span class="featured-collection__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <{{ section.settings.heading_size | default: 'h2' }} class="featured-collection__heading">
            {{ section.settings.heading }}
          </{{ section.settings.heading_size | default: 'h2' }}>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="featured-collection__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
      {% if section.settings.show_view_all and section.settings.view_all_text != blank %}
        <a
          class="featured-collection__view-all link-arrow"
          href="{{ section.settings.view_all_link | default: section.settings.collection.url | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.view_all_text }}
        </a>
      {% endif %}
    </div>
  {% else %}
    <div class="section-resource-list__header">
      {%- content_for 'block', type: '_product-list-content', id: 'static-header' -%}
    </div>
  {% endif %}

  {%- comment -%} Slider Outer Container {%- endcomment -%}
  {% liquid
    assign is_full_slider = false
    if section.settings.layout_mode == 'slider' or section.settings.enable_full_slider == true
      assign is_full_slider = true
    endif

    assign desktop_slider = false
    if is_full_slider or section.settings.enable_desktop_slider == true
      assign desktop_slider = true
    endif

    assign mobile_slider = false
    if section.settings.enable_custom_slider != false
      if is_full_slider or section.settings.enable_mobile_slider != false
        assign mobile_slider = true
      endif
    endif

    assign arrow_opt = section.settings.arrow_option
    if is_full_slider and section.settings.arrow_option == 'arrow-only-mobile'
      assign arrow_opt = 'arrow-show-both'
    endif
  %}

  <div class="slider-outer {{ section.settings.arrow_position }} {{ section.settings.dots_option }} {{ arrow_opt }}{% if desktop_slider %} is-desktop-slider{% else %} is-desktop-grid{% endif %}{% if mobile_slider %} is-mobile-slider{% else %} is-mobile-grid{% endif %}">
    <div
      id="new-swiper-{{ unique_id }}"
      class="slider-btn new-swiper-container swiper"
      data-id="{{ unique_id }}"
      data-mobile-slider="{{ mobile_slider }}"
      data-tablet-slider="{{ mobile_slider }}"
      data-desktop-slider="{{ desktop_slider }}"
      data-slides-per-view-desktop="{{ section.settings.slides_per_view_desktop | default: 4 }}"
      data-space-between-desktop="{{ section.settings.space_between_desktop | default: 16 }}"
      data-slides-per-view-laptop="{{ section.settings.slides_per_view_laptop | default: section.settings.slides_per_view_desktop | default: 3 }}"
      data-space-between-laptop="{{ section.settings.space_between_laptop | default: section.settings.space_between_desktop | default: 16 }}"
      data-slides-per-view-tablet="{{ section.settings.slides_per_view_tablet | default: 2.5 }}"
      data-space-between-tablet="{{ section.settings.space_between_tablet | default: section.settings.space_between_mobile | default: 12 }}"
      data-slides-per-view-medium-tablet="{{ section.settings.slides_per_view_medium_tablet | default: 2 }}"
      data-space-between-medium-tablet="{{ section.settings.space_between_medium_tablet | default: section.settings.space_between_mobile | default: 12 }}"
      data-slides-per-view-mobile="{{ section.settings.slides_per_view_mobile | default: 1.8 }}"
      data-space-between-mobile="{{ section.settings.space_between_mobile | default: 12 }}"
      data-arrows-enabled="{{ section.settings.arrows_enabled }}"
      data-autoplay-enabled="{{ section.settings.autoplay_enabled }}"
      data-autoplay-delay="{{ section.settings.autoplay_delay }}"
      data-loop-enabled="{{ section.settings.loop_enabled }}"
      data-dots-enabled="{{ section.settings.dots_enabled }}"
      data-centered-enabled="{{ section.settings.centered_enabled }}"
    >
      <div
        id="{{ unique_id }}"
        class="
          featured-collection__container
          {% if desktop_slider or mobile_slider %} swiper-wrapper {% endif %}
          {% if desktop_slider != true %} desktop-grid laptop-grid {% endif %}
          {% if mobile_slider != true %} mobile-grid {% endif %}
        "
      >
        {%- assign pastel_palette = '#fce4ec,#e8e0f5,#faeee5,#f8e2e9,#e3def7,#fdf4e9,#eaf3e9,#fef9e7' | split: ',' -%}
        {%- assign featured_collection = section.settings.collection -%}
        {%- if featured_collection == blank -%}
          {%- assign featured_collection = collections.all -%}
        {%- endif -%}

        {% if featured_collection != blank and featured_collection.products_count > 0 %}
          {% for product in featured_collection.products limit: max_items %}
            {%- assign bg_index = forloop.index0 | modulo: 8 -%}
            {%- assign pastel_bg = pastel_palette[bg_index] -%}
            <div
              class="
                {% if desktop_slider or mobile_slider %}
                  swiper-slide
                {% endif %}
                prdocut_slider_item
              "
              style="--card-media-bg: {{ pastel_bg }};"
            >
              <div class="resource-list__item" style="width: 100%;">
                {% content_for 'block',
                  type: '_product-card',
                  id: 'static-product-card',
                  closest.product: product,
                  product_view_context: 'collection'
                %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..max_items) %}
            {%- assign bg_index = forloop.index0 | modulo: 8 -%}
            {%- assign pastel_bg = pastel_palette[bg_index] -%}
            <div
              class="
                {% if desktop_slider or mobile_slider %}
                  swiper-slide
                {% endif %}
                prdocut_slider_item
              "
              style="--card-media-bg: {{ pastel_bg }};"
            >
              <div class="resource-list__item" style="width: 100%;">
                {% content_for 'block', type: '_product-card', id: 'static-product-card', closest.product: null %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    {% if section.settings.dots_enabled %}
      <div class="pagination-container">
        <div class="swiper-pagination"></div>
      </div>
    {% endif %}

    {% if section.settings.arrows_enabled %}
      <span class="swipwer--btn swiper-button-previ" data-swiper-id="{{ unique_id }}" aria-label="Previous">
        {% render 'slider-arrow-left' %}
      </span>
      <span class="swipwer--btn swiper-button-nexts" data-swiper-id="{{ unique_id }}" aria-label="Next">
        {% render 'slider-arrow-right' %}
      </span>
    {% endif %}
  </div>
</div>

<script src="{{ 'arrow-out-slider.js' | asset_url }}" defer="defer"></script>

{% style %}
  /* Section Header */
  .featured-collection__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .featured-collection__header--center {
    justify-content: center;
    text-align: center;
  }
  .featured-collection__header--center .featured-collection__header-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .featured-collection__eyebrow {
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary, #d32f2f);
    margin-bottom: 8px;
    font-family: var(--font-body--family, 'Nunito', sans-serif);
  }
  .featured-collection__heading {
    font-family: Fredoka, var(--font-heading--family, sans-serif);
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 700;
    color: #2d2d2d;
    margin: 0 0 8px 0;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .featured-collection__subheading {
    font-family: var(--font-body--family, 'Nunito', sans-serif);
    font-size: 15px;
    color: #6b7280;
    margin: 0;
    line-height: 1.5;
    max-width: 620px;
  }
  .featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--primary, #d32f2f);
    font-size: 15px;
    text-decoration: none;
    transition: gap 0.2s, color 0.2s;
    white-space: nowrap;
    margin-top: 8px;
  }
  .featured-collection__view-all:hover {
    gap: 10px;
    color: #b71c1c;
  }

  /* Grid Layout (Desktop fallback when desktop slider is disabled) */
  @media (min-width: 1025px) {
    .featured-collection__container.desktop-grid {
      display: grid !important;
      grid-template-columns: repeat(var(--desktop-columns, 4), 1fr) !important;
      column-gap: var(--desktop-col-gap, 16px) !important;
      row-gap: var(--desktop-row-gap, 24px) !important;
      width: 100% !important;
      transform: none !important;
    }
    .featured-collection__container.desktop-grid .swiper-slide {
      width: auto !important;
      margin-right: 0 !important;
      transform: none !important;
    }
    /* Hide slider controls and reset padding on desktop when desktop is a grid */
    .slider-outer.is-desktop-grid.arrows-bottom {
      padding-bottom: 0 !important;
    }
    .slider-outer.is-desktop-grid .swipwer--btn,
    .slider-outer.is-desktop-grid .swiper-button-previ,
    .slider-outer.is-desktop-grid .swiper-button-nexts,
    .slider-outer.is-desktop-grid .pagination-container,
    .slider-outer.is-desktop-grid .swiper-pagination {
      display: none !important;
    }
  }

  /* Desktop Swiper Layout (when desktop slider is enabled) */
  @media (min-width: 1025px) {
    .new-swiper-container[data-desktop-slider="true"] {
      overflow: hidden !important;
      width: 100% !important;
    }
    .new-swiper-container[data-desktop-slider="true"] .swiper-wrapper {
      display: flex !important;
      flex-wrap: nowrap !important;
      width: 100% !important;
    }
    .new-swiper-container[data-desktop-slider="true"] .swiper-slide {
      height: auto !important;
      display: flex !important;
      flex-shrink: 0 !important;
    }
  }

  /* Grid Layout (Laptop/Tablet fallback when slider is disabled) */
  @media (min-width: 769px) and (max-width: 1024px) {
    .featured-collection__container.laptop-grid:not(.swiper-wrapper) {
      display: grid !important;
      grid-template-columns: repeat(var(--laptop-columns, 3), 1fr) !important;
      column-gap: var(--desktop-col-gap, 16px) !important;
      row-gap: var(--desktop-row-gap, 24px) !important;
      width: 100% !important;
      transform: none !important;
    }
    .featured-collection__container.laptop-grid:not(.swiper-wrapper) .swiper-slide {
      width: auto !important;
      margin-right: 0 !important;
    }
  }

  /* Grid Layout (Mobile fallback when slider is disabled) */
  @media (max-width: 768px) {
    .featured-collection__container.mobile-grid:not(.swiper-wrapper) {
      display: grid !important;
      grid-template-columns: repeat(var(--mobile-columns, 2), 1fr) !important;
      column-gap: var(--mobile-col-gap, 12px) !important;
      row-gap: var(--mobile-row-gap, 16px) !important;
      width: 100% !important;
      transform: none !important;
    }
    .featured-collection__container.mobile-grid:not(.swiper-wrapper) .swiper-slide {
      width: auto !important;
      margin-right: 0 !important;
    }
  }

  /* Mobile & Tablet Swiper Layout */
  @media (max-width: 1024px) {
    .new-swiper-container[data-mobile-slider="true"],
    .new-swiper-container[data-tablet-slider="true"] {
      overflow: hidden !important;
      width: 100% !important;
    }
    .new-swiper-container[data-mobile-slider="true"] .swiper-wrapper,
    .new-swiper-container[data-tablet-slider="true"] .swiper-wrapper {
      display: flex !important;
      flex-wrap: nowrap !important;
      width: 100% !important;
    }
    .new-swiper-container[data-mobile-slider="true"] .swiper-slide,
    .new-swiper-container[data-tablet-slider="true"] .swiper-slide {
      height: auto !important;
      display: flex !important;
      flex-shrink: 0 !important;
    }
    .slider-outer.is-mobile-slider .swipwer--btn,
    .slider-outer.is-mobile-slider .swiper-button-previ,
    .slider-outer.is-mobile-slider .swiper-button-nexts {
      display: flex !important;
    }
    .slider-outer.is-mobile-slider .pagination-container,
    .slider-outer.is-mobile-slider .swiper-pagination {
      display: flex !important;
    }
  }

  /* Swiper Button Styling */
  .featured-collection-section .swipwer--btn {
    background-color: var(--primary, #d32f2f) !important;
    color: #fff !important;
    box-shadow: 0 4px 14px rgba(211, 47, 47, 0.28);
    border: none;
    border-radius: 50%;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s, background-color 0.2s, box-shadow 0.2s;
    z-index: 10;
  }
  .featured-collection-section .swipwer--btn:hover {
    background-color: #b71c1c !important;
    transform: scale(1.1);
    box-shadow: 0 6px 18px rgba(211, 47, 47, 0.38);
  }
  .featured-collection-section .swipwer--btn svg {
    width: 14px;
    height: 14px;
  }
  .featured-collection-section .swipwer--btn svg path {
    fill: #ffffff !important;
    stroke: #ffffff !important;
  }
  .featured-collection-section .swipwer--btn[aria-disabled="true"] {
    background-color: #f1f1f1 !important;
    opacity: 0.45;
    cursor: not-allowed;
  }
  .featured-collection-section .swipwer--btn[aria-disabled="true"] svg path {
    fill: #888888 !important;
    stroke: #888888 !important;
  }
{% endstyle %}

{% schema %}
{
  "name": "Featured collection",
  "class": "ui-test-product-list",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Small heading",
      "default": "PREVIEW PICKS"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers & sweet finds"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large (h1)" },
        { "value": "h2", "label": "Medium (h2)" },
        { "value": "h3", "label": "Small (h3)" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading / Description",
      "default": "A handpicked mix of plush pals, pens, and gifts."
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "'View all' link text",
      "default": "Shop all best sellers →"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "'View all' link URL"
    },
    {
      "type": "header",
      "content": "Products Selection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout Mode"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "options": [
        { "value": "grid", "label": "Grid on desktop, Slider on mobile & tablet" },
        { "value": "slider", "label": "Completely Slider (carousel on all screens)" }
      ],
      "default": "grid",
      "info": "Switch to 'Completely Slider' to display products in a continuous sliding row without a multi-row grid"
    },
    {
      "type": "checkbox",
      "id": "enable_full_slider",
      "label": "Make completely slider",
      "default": false,
      "info": "Enable full carousel slider on both desktop and mobile/tablet"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_laptop",
      "label": "Laptop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns (when slider disabled)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "slide_columns_gap",
      "label": "Desktop horizontal gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "slide_row_gap",
      "label": "Desktop vertical gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "slide_mobile_columns_gap",
      "label": "Mobile horizontal gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "slide_mobile_row_gap",
      "label": "Mobile vertical gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_custom_slider",
      "label": "Enable Custom Slider System",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "label": "Enable Mobile & Tablet Slider",
      "default": true,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "label": "Enable Desktop Slider",
      "default": false,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "label": "Desktop items per view",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "default": 4,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_laptop",
      "label": "Laptop items per view",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 3,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_tablet",
      "label": "Tablet items per view",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "default": 2,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_medium_tablet",
      "label": "Medium Tablet items per view",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "default": 2,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "range",
      "id": "slides_per_view_mobile",
      "label": "Mobile items per view",
      "min": 1,
      "max": 4,
      "step": 0.1,
      "default": 1.8,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "range",
      "id": "space_between_desktop",
      "label": "Desktop space between items",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 16,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "range",
      "id": "space_between_mobile",
      "label": "Mobile space between items",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 12,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "checkbox",
      "id": "arrows_enabled",
      "label": "Enable arrows",
      "default": true,
      "visible_if": "{{ section.settings.enable_custom_slider == true }}"
    },
    {
      "type": "select",
      "id": "arrow_position",
      "options": [
        { "value": "arrows-bottom", "label": "Bottom" },
        { "value": "arrows-left-and-right", "label": "Left & Right" }
      ],
      "default": "arrows-bottom",
      "label": "Arrow position",
