{%- comment -%}
  Customer Reviews Section — Mochi Mart
  Fully customizable Swiper slider showcasing customer reviews & testimonials with Lovable aesthetic.
{%- endcomment -%}

<div
  class="customer-reviews-section color-{{ section.settings.color_scheme }}"
  id="CustomerReviewsSection-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    {%- if section.settings.custom_bg_color != blank -%}
      --reviews-bg: {{ section.settings.custom_bg_color }};
    {%- else -%}
      --reviews-bg: transparent;
    {%- endif -%}
    --reviews-pt: {{ section.settings.padding_top }}px;
    --reviews-pb: {{ section.settings.padding_bottom }}px;
    --reviews-eyebrow-color: {{ section.settings.eyebrow_color | default: '#d32f2f' }};
    --reviews-heading-color: {{ section.settings.heading_color | default: '#2c221e' }};
    --reviews-heading-size: {{ section.settings.heading_size }}px;
    --reviews-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --reviews-card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --reviews-card-radius: {{ section.settings.card_border_radius }}px;
    --reviews-card-border: {{ section.settings.card_border_color | default: '#efeae2' }};
    --reviews-star-color: {{ section.settings.star_color | default: '#d32f2f' }};
    --reviews-quote-color: {{ section.settings.quote_color | default: '#2c2523' }};
    --reviews-quote-size: {{ section.settings.quote_size }}px;
    --reviews-author-color: {{ section.settings.author_color | default: '#78716c' }};
    --reviews-disclaimer-color: {{ section.settings.disclaimer_color | default: '#9ca3af' }};
    --reviews-arrow-bg: {{ section.settings.arrow_bg_color | default: '#ffffff' }};
    --reviews-arrow-color: {{ section.settings.arrow_color | default: '#2c221e' }};
    --reviews-dot-color: {{ section.settings.dot_color | default: '#d6d3d1' }};
    --reviews-dot-active: {{ section.settings.dot_active_color | default: '#d32f2f' }};
  "
>
  <div class="customer-reviews__wrapper customer-reviews__wrapper--{{ section.settings.section_width }}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
      <div class="customer-reviews__header customer-reviews__header--{{ section.settings.heading_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <div class="customer-reviews__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="customer-reviews__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <p class="customer-reviews__description">
            {{ section.settings.description }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="customer-reviews__slider-container">
      {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
        <button
          type="button"
          class="customer-reviews__arrow customer-reviews__arrow--prev"
          id="ReviewsPrev-{{ section.id }}"
          aria-label="Previous review"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {%- endif -%}

      <div class="swiper customer-reviews__swiper" id="CustomerReviewsSwiper-{{ section.id }}">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div class="swiper-slide customer-reviews__slide" {{ block.shopify_attributes }}>
              <div class="customer-reviews__card">
                <div class="customer-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                  {%- assign rating_val = block.settings.rating | default: 5 -%}
                  {%- for i in (1..5) -%}
                    {%- if i <= rating_val -%}
                      <svg class="customer-reviews__star customer-reviews__star--filled" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                      </svg>
                    {%- else -%}
                      <svg class="customer-reviews__star customer-reviews__star--empty" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                      </svg>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                {%- if block.settings.quote != blank -%}
                  <div class="customer-reviews__quote">
                    {{ block.settings.quote }}
                  </div>
                {%- endif -%}

                {%- if block.settings.author != blank -%}
                  <div class="customer-reviews__author">
                    <span class="customer-reviews__author-dash">—</span> {{ block.settings.author }}
                    {%- if block.settings.verified -%}
                      <span class="customer-reviews__verified-badge" title="Verified Customer">
                        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                      </span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.show_dots and section.blocks.size > 1 -%}
          <div class="swiper-pagination customer-reviews__pagination" id="ReviewsPagination-{{ section.id }}"></div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_arrows and section.blocks.size > 1 -%}
        <button
          type="button"
          class="customer-reviews__arrow customer-reviews__arrow--next"
          id="ReviewsNext-{{ section.id }}"
          aria-label="Next review"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {%- endif -%}
    </div>

    {%- if section.settings.show_disclaimer and section.settings.disclaimer_text != blank -%}
      <div class="customer-reviews__disclaimer">
        {{ section.settings.disclaimer_text }}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #CustomerReviewsSection-{{ section.id }} {
    background-color: var(--reviews-bg);
    padding-top: var(--reviews-pt);
    padding-bottom: var(--reviews-pb);
    font-family: var(--font-body--family, "DM Sans", -apple-system, BlinkMacSystemFont, sans-serif);
    position: relative;
    overflow: hidden;
  }

  #CustomerReviewsSection-{{ section.id }} .customer-reviews__wrapper--page-width {
    max-width: var(--page-width, 1320px);
    margin: 0 auto;
    padding: 0 20px;
  }

  #CustomerReviewsSection-{{ section.id }} .customer-reviews__wrapper--full-width {
    width: 100%;
    padding: 0 24px;
  }

  @media (min-width: 768px) {
    #CustomerReviewsSection-{{ section.id }} .customer-reviews__wrapper--page-width {
      padding: 0 32px;
    }
  }

  /* Header */
  .customer-reviews__header {
    margin-bottom: 36px;
  }

  .customer-reviews__header--center {
    text-align: center;
  }

  .customer-reviews__header--left {
    text-align: left;
  }

  .customer-reviews__header--right {
    text-align: right;
  }

  .customer-reviews__eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--reviews-eyebrow-color);
    margin-bottom: 12px;
  }

  .customer-reviews__heading {
    font-family: var(--font-heading--family, "Fredoka", "DM Sans", sans-serif);
    font-size: var(--reviews-heading-size);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--reviews-heading-color);
    margin: 0;
  }

  @media (max-width: 767px) {
    .customer-reviews__heading {
      font-size: var(--reviews-heading-size-mobile);
    }
    .customer-reviews__header {
      margin-bottom: 28px;
    }
  }

  .customer-reviews__description {
    font-size: 15px;
    color: var(--reviews-author-color);
    margin: 10px 0 0;
    max-width: 600px;
    display: inline-block;
  }

  /* Slider Container */
  .customer-reviews__slider-container {
    position: relative;
    width: 100%;
  }

  .customer-reviews__swiper {
    width: 100%;
    padding: 10px 4px 18px !important;
    overflow: hidden;
  }

  .customer-reviews__slide {
    height: auto;
    display: flex;
  }

  /* Card */
  .customer-reviews__card {
    background-color: var(--reviews-card-bg);
    border-radius: var(--reviews-card-radius);
    border: 1px solid var(--reviews-card-border);
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    width: 100%;
    min-height: 190px;
    box-sizing: border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  {%- if section.settings.card_hover_lift -%}
  .customer-reviews__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.08);
  }
  {%- endif -%}

  @media (max-width: 767px) {
    .customer-reviews__card {
      padding: 24px 22px;
      min-height: 175px;
    }
  }

  /* Stars */
  .customer-reviews__stars {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--reviews-star-color);
    margin-bottom: 18px;
  }

  .customer-reviews__star {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .customer-reviews__star--empty {
    opacity: 0.25;
  }

  /* Quote */
  .customer-reviews__quote {
    font-size: var(--reviews-quote-size);
    font-weight: 500;
    line-height: 1.5;
    color: var(--reviews-quote-color);
    margin-bottom: 20px;
    letter-spacing: -0.01em;
  }

  .customer-reviews__quote p {
    margin: 0;
  }

  @media (max-width: 767px) {
    .customer-reviews__quote {
      font-size: calc(var(--reviews-quote-size) - 1px);
    }
  }

  /* Author */
  .customer-reviews__author {
    margin-top: auto;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--reviews-author-color);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .customer-reviews__author-dash {
    color: var(--reviews-author-color);
    opacity: 0.8;
  }

  .customer-reviews__verified-badge {
    display: inline-flex;
    align-items: center;
    width: 14px;
    height: 14px;
    color: #10b981;
    margin-left: 2px;
  }

  .customer-reviews__verified-badge svg {
    width: 100%;
    height: 100%;
  }

  /* Navigation Arrows */
  .customer-reviews__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--reviews-card-border);
    background-color: var(--reviews-arrow-bg);
    color: var(--reviews-arrow-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
  }

  .customer-reviews__arrow:hover {
    transform: translateY(-50%) scale(1.08);
    background-color: #fff;
  }

  .customer-reviews__arrow svg {
    width: 20px;
    height: 20px;
  }

  .customer-reviews__arrow--prev {
    left: -22px;
  }

  .customer-reviews__arrow--next {
    right: -22px;
  }

  .customer-reviews__arrow.swiper-button-disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  @media (max-width: 1100px) {
    .customer-reviews__arrow {
      display: none !important;
    }
  }

  /* Pagination Dots */
  .customer-reviews__pagination {
    position: relative !important;
    margin-top: 18px !important;
    bottom: auto !important;
    left: auto !important;
    width: 100% !important;
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  .customer-reviews__pagination .swiper-pagination-bullet {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: var(--reviews-dot-color);
    opacity: 0.7;
    transition: width 0.25s ease, background-color 0.25s ease, opacity 0.25s ease;
    margin: 0 !important;
  }

  .customer-reviews__pagination .swiper-pagination-bullet-active {
    width: 22px;
    border-radius: 999px;
    background-color: var(--reviews-dot-active);
    opacity: 1;
  }

  /* Disclaimer */
  .customer-reviews__disclaimer {
    margin-top: 26px;
    text-align: center;
    font-size: 12px;
    line-height: 1.4;
    color: var(--reviews-disclaimer-color);
  }

  .customer-reviews__disclaimer p {
    margin: 0;
  }
</style>

<script>
  (function () {
    function initReviewsSlider() {
      if (typeof Swiper === 'undefined') {
        setTimeout(initReviewsSlider, 60);
        return;
      }

      var sliderEl = document.getElementById('CustomerReviewsSwiper-{{ section.id }}');
      if (!sliderEl) return;

      if (sliderEl.swiper) {
        sliderEl.swiper.destroy(true, true);
      }

      var slidesMobile = parseFloat('{{ section.settings.slides_per_view_mobile | default: "1.15" }}');

      var swiperOptions = {
        slidesPerView: slidesMobile,
        spaceBetween: {{ section.settings.space_between_mobile | default: 16 }},
        grabCursor: true,
        watchOverflow: true,
        loop: {{ section.settings.loop_enabled | default: true }},
        {%- if section.settings.autoplay_enabled -%}
        autoplay: {
          delay: {{ section.settings.autoplay_delay | default: 4000 }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        },
        {%- endif -%}
        {%- if section.settings.show_arrows -%}
        navigation: {
          prevEl: '#ReviewsPrev-{{ section.id }}',
          nextEl: '#ReviewsNext-{{ section.id }}'
        },
        {%- endif -%}
        {%- if section.settings.show_dots -%}
        pagination: {
          el: '#ReviewsPagination-{{ section.id }}',
          clickable: true
        },
        {%- endif -%}
        breakpoints: {
          640: {
            slidesPerView: {{ section.settings.slides_per_view_tablet | default: 2 }},
            spaceBetween: {{ section.settings.space_between_desktop | default: 24 }}
          },
          1024: {
            slidesPerView: {{ section.settings.slides_per_view_desktop | default: 3 }},
            spaceBetween: {{ section.settings.space_between_desktop | default: 24 }}
          }
        }
      };

      new Swiper(sliderEl, swiperOptions);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReviewsSlider);
    } else {
      initReviewsSlider();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target && e.target.getAttribute('data-section-id') === '{{ section.id }}') {
        initReviewsSlider();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "class": "customer-reviews-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Headings & Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Subheading",
      "default": "A PREVIEW OF HAPPY MOMENTS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The sweet word is out."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size (Desktop)",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading font size (Mobile)",
      "min": 20,
      "max": 42,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Optional description text"
    },
    {
      "type": "header",
      "content": "Disclaimer Note"
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show disclaimer below slider",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "disclaimer_text",
      "label": "Disclaimer text",
      "default": "Illustrative sample reviews for this storefront preview; not verified customer feedback."
    },
    {
      "type": "header",
      "content": "Slider Settings (Swiper)"
    },
    {
      "type": "range",
      "id": "slides_per_view_desktop",
      "label": "Reviews per row (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "slides_per_view_tablet",
      "label": "Reviews per row (Tablet)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "slides_per_view_mobile",
      "label": "Reviews per row (Mobile)",
      "options": [
        { "value": "1", "label": "1 slide" },
        { "value": "1.15", "label": "1 slide + peek next (1.15)" },
        { "value": "1.25", "label": "1 slide + wide peek (1.25)" },
        { "value": "2", "label": "2 slides" }
      ],
      "default": "1.15"
    },
    {
      "type": "range",
      "id": "space_between_desktop",
      "label": "Space between reviews (Desktop)",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "space_between_mobile",
      "label": "Space between reviews (Mobile)",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "loop_enabled",
      "label": "Enable infinite loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay_enabled",
      "label": "Enable auto-slide",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Auto-slide speed (ms)",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "default": 4000
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#efeae2"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card corner radius",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "card_hover_lift",
      "label": "Subtle hover lift effect",
      "default": true
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "Quote font size",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "custom_bg_color",
      "label": "Custom section background",
      "info": "Leave blank to inherit from color scheme"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow text color",
      "default": "#d32f2f"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text color",
      "default": "#2c221e"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star rating color",
      "default": "#d32f2f"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Review quote color",
      "default": "#2c2523"
    },
    {
      "type": "color",
      "id": "author_color",
      "label": "Author text color",
      "default": "#78716c"
    },
    {
      "type": "color",
      "id": "disclaimer_color",
      "label": "Disclaimer text color",
      "default": "#9ca3af"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow icon color",
      "default": "#2c221e"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Inactive dot color",
      "default": "#d6d3d1"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active dot color",
      "default": "#d32f2f"
    },
    {
      "type": "header",
      "content": "Section Layout & Spacing"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
