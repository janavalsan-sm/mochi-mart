{%- comment -%}
  Customer Reviews Section — Mochi Mart
  Fully customizable slider showcasing customer reviews & testimonials with Lovable aesthetic.
  Supports both Swiper slider & responsive grid layouts with mobile/desktop controls.
{%- endcomment -%}

{% assign unique_id = 'customer-reviews-' | append: section.id %}
{{ 'slider-styles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = section.settings.color_scheme.id | default: section.settings.color_scheme
  if color_scheme == blank
    assign color_scheme = 'scheme-1'
  endif

  assign has_custom_bg = false
  if section.settings.custom_bg_color != blank and section.settings.custom_bg_color != 'rgba(0,0,0,0)' and section.settings.custom_bg_color != 'transparent'
    assign has_custom_bg = true
    render 'contrast-override', background_color: section.settings.custom_bg_color, section_id: section.id
  endif

  assign is_full_slider = false
  if section.settings.layout_mode == 'slider' or section.settings.enable_full_slider == true
    assign is_full_slider = true
  endif

  assign desktop_slider = false
  if is_full_slider or section.settings.enable_desktop_slider == true
    assign desktop_slider = true
  endif

  assign mobile_slider = false
  if section.settings.enable_custom_slider != false
    if is_full_slider or section.settings.enable_mobile_slider != false
      assign mobile_slider = true
    endif
  endif

  assign arrow_opt = section.settings.arrow_option
  if is_full_slider and section.settings.arrow_option == 'arrow-only-mobile'
    assign arrow_opt = 'arrow-show-both'
  endif
-%}

<div class="section-background color-{{ color_scheme }}{% if has_custom_bg %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="
    section
    customer-reviews-section
    section--{{ section.settings.section_width }}
    color-{{ color_scheme }}
    {% if has_custom_bg %}color-custom-{{ section.id }}{% endif %}
    spacing-style
  "
  id="CustomerReviewsSection-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    {% render 'spacing-style', settings: section.settings %};
    {%- if has_custom_bg -%}
      --reviews-bg: {{ section.settings.custom_bg_color }};
    {%- else -%}
      --reviews-bg: var(--color-background);
    {%- endif -%}
    --reviews-eyebrow-color: {{ section.settings.eyebrow_color | default: '#d32f2f' }};
    --reviews-heading-color: {{ section.settings.heading_color | default: 'var(--color-foreground-heading, var(--color-foreground, #2c221e))' }};
    --reviews-heading-size: {{ section.settings.heading_size | default: 44 }}px;
    --reviews-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 30 }}px;
    --reviews-card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --reviews-card-radius: {{ section.settings.card_border_radius | default: 24 }}px;
    --reviews-card-border: {{ section.settings.card_border_color | default: '#efeae2' }};
    --reviews-star-color: {{ section.settings.star_color | default: '#d32f2f' }};
    --reviews-quote-color: {{ section.settings.quote_color | default: '#2c2523' }};
    --reviews-quote-size: {{ section.settings.quote_size | default: 16 }}px;
    --reviews-author-color: {{ section.settings.author_color | default: '#78716c' }};
    --reviews-disclaimer-color: {{ section.settings.disclaimer_color | default: '#9ca3af' }};
    --desktop-columns: {{ section.settings.columns | default: 3 }};
    --laptop-columns: {{ section.settings.columns_laptop | default: 3 }};
    --tablet-columns: {{ section.settings.columns_tablet | default: 2 }};
    --mobile-columns: {{ section.settings.mobile_columns | default: 1 }};
    --desktop-col-gap: {{ section.settings.slide_columns_gap | default: 24 }}px;
    --desktop-row-gap: {{ section.settings.slide_row_gap | default: 24 }}px;
    --mobile-col-gap: {{ section.settings.slide_mobile_columns_gap | default: 16 }}px;
    --mobile-row-gap: {{ section.settings.slide_mobile_row_gap | default: 16 }}px;
  "
>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
    <div class="customer-reviews__header customer-reviews__header--{{ section.settings.heading_alignment | default: 'center' }}">
      {%- if section.settings.eyebrow != blank -%}
        <div class="customer-reviews__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="customer-reviews__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="customer-reviews__description">
          {{ section.settings.description }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="slider-outer {{ section.settings.arrow_position | default: 'arrows-left-and-right' }} {{ section.settings.dots_option | default: 'only-mobile' }} {{ arrow_opt }}{% if desktop_slider %} is-desktop-slider{% else %} is-desktop-grid{% endif %}{% if mobile_slider %} is-mobile-slider{% else %} is-mobile-grid{% endif %}">
    <div
      id="new-swiper-{{ unique_id }}"
      class="slider-btn new-swiper-container swiper"
      data-id="{{ unique_id }}"
      data-mobile-slider="{{ mobile_slider }}"
      data-tablet-slider="{{ mobile_slider }}"
      data-desktop-slider="{{ desktop_slider }}"
      data-slides-per-view-desktop="{{ section.settings.slides_per_view_desktop | default: 3 }}"
      data-space-between-desktop="{{ section.settings.space_between_desktop | default: 24 }}"
      data-slides-per-view-laptop="{{ section.settings.slides_per_view_laptop | default: section.settings.slides_per_view_desktop | default: 3 }}"
      data-space-between-laptop="{{ section.settings.space_between_laptop | default: section.settings.space_between_desktop | default: 24 }}"
      data-slides-per-view-tablet="{{ section.settings.slides_per_view_tablet | default: 2 }}"
      data-space-between-tablet="{{ section.settings.space_between_tablet | default: section.settings.space_between_mobile | default: 16 }}"
      data-slides-per-view-medium-tablet="{{ section.settings.slides_per_view_medium_tablet | default: 2 }}"
      data-space-between-medium-tablet="{{ section.settings.space_between_medium_tablet | default: section.settings.space_between_mobile | default: 16 }}"
      data-slides-per-view-mobile="{{ section.settings.slides_per_view_mobile | default: 1.2 }}"
      data-space-between-mobile="{{ section.settings.space_between_mobile | default: 16 }}"
      data-arrows-enabled="{{ section.settings.arrows_enabled }}"
      data-autoplay-enabled="{{ section.settings.autoplay_enabled }}"
      data-autoplay-delay="{{ section.settings.autoplay_delay | default: 4000 }}"
      data-loop-enabled="{{ section.settings.loop_enabled }}"
      data-dots-enabled="{{ section.settings.dots_enabled }}"
    >
      <div
        id="{{ unique_id }}"
        class="
          customer-reviews__container
          {% if desktop_slider or mobile_slider %} swiper-wrapper {% endif %}
          {% if desktop_slider != true %} desktop-grid laptop-grid {% endif %}
          {% if mobile_slider != true %} mobile-grid {% endif %}
        "
      >
        {%- for block in section.blocks -%}
          <div class="{% if desktop_slider or mobile_slider %}swiper-slide{% endif %} customer-reviews__slide" {{ block.shopify_attributes }}>
            <div class="customer-reviews__card">
              <div class="customer-reviews__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- assign rating_val = block.settings.rating | default: 5 -%}
                {%- for i in (1..5) -%}
                  {%- if i <= rating_val -%}
                    <svg class="customer-reviews__star customer-reviews__star--filled" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  {%- else -%}
                    <svg class="customer-reviews__star customer-reviews__star--empty" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if block.settings.quote != blank -%}
                <div class="customer-reviews__quote">
                  {{ block.settings.quote }}
                </div>
              {%- endif -%}

              {%- if block.settings.author != blank -%}
                <div class="customer-reviews__author">
                  <span class="customer-reviews__author-dash">—</span> {{ block.settings.author }}
                  {%- if block.settings.verified -%}
                    <span class="customer-reviews__verified-badge" title="Verified Customer">
                      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.dots_enabled and section.blocks.size > 1 -%}
      <div class="pagination-container {{ section.settings.dots_option }}">
        <div class="swiper-pagination"></div>
      </div>
    {%- endif -%}

    {%- if section.settings.arrows_enabled and section.blocks.size > 1 -%}
      <span class="swipwer--btn swiper-button-previ" data-swiper-id="{{ unique_id }}" aria-label="Previous">
        {% render 'slider-arrow-left' %}
      </span>
      <span class="swipwer--btn swiper-button-nexts" data-swiper-id="{{ unique_id }}" aria-label="Next">
        {% render 'slider-arrow-right' %}
      </span>
    {%- endif -%}
  </div>

  {%- if section.settings.show_disclaimer and section.settings.disclaimer_text != blank -%}
    <div class="customer-reviews__disclaimer">
      {{ section.settings.disclaimer_text }}
    </div>
  {%- endif -%}
</div>

<script src="{{ 'arrow-out-slider.js' | asset_url }}" defer="defer"></script>

<style>
  .shopify-section:has(.customer-reviews-section) {
    position: relative;
    isolation: isolate;
  }

  .customer-reviews-section {
    position: relative;
    z-index: 1;
    background-color: transparent !important;
    font-family: var(--font-body--family, "DM Sans", -apple-system, BlinkMacSystemFont, sans-serif);
  }

  .customer-reviews-section .section-background {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--reviews-bg);
  }

  /* Direct grid item placement for Horizon page-width grid */
  .customer-reviews-section > .customer-reviews__header,
  .customer-reviews-section > .slider-outer,
  .customer-reviews-section > .customer-reviews__disclaimer {
    grid-column: 2;
    min-width: 0;
    max-width: 100%;
    width: 100%;
  }

  /* Header */
  .customer-reviews__header {
    margin-bottom: 36px;
  }

  .customer-reviews__header--center {
    text-align: center;
  }

  .customer-reviews__header--left {
    text-align: left;
  }

  .customer-reviews__header--right {
    text-align: right;
  }

  .customer-reviews__eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--reviews-eyebrow-color);
    margin-bottom: 12px;
  }

  .customer-reviews__heading {
    font-family: var(--font-heading--family, "Fredoka", "DM Sans", sans-serif);
    font-size: var(--reviews-heading-size);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--reviews-heading-color);
    margin: 0;
  }

  @media (max-width: 767px) {
    .customer-reviews__heading {
      font-size: var(--reviews-heading-size-mobile);
    }
    .customer-reviews__header {
      margin-bottom: 28px;
    }
  }

  .customer-reviews__description {
    font-size: 15px;
    color: var(--reviews-author-color);
    margin: 10px 0 0;
    max-width: 600px;
    display: inline-block;
  }

  /* Slider Outer */
  .customer-reviews-section .slider-outer {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .customer-reviews-section .new-swiper-container {
    overflow: hidden !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
  }

  .customer-reviews-section .new-swiper-container .swiper-wrapper {
    box-sizing: border-box !important;
  }

  /* Grid Layout (Desktop fallback when desktop slider is disabled) */
  @media (min-width: 1025px) {
    .customer-reviews__container.desktop-grid:not(.swiper-wrapper) {
      display: grid !important;
      grid-template-columns: repeat(var(--desktop-columns, 3), 1fr) !important;
      column-gap: var(--desktop-col-gap, 24px) !important;
      row-gap: var(--desktop-row-gap, 24px) !important;
      width: 100% !important;
      transform: none !important;
    }
    .customer-reviews__container.desktop-grid:not(.swiper-wrapper) .swiper-slide,
    .customer-reviews__container.desktop-grid:not(.swiper-wrapper) .customer-reviews__slide {
      width: auto !important;
      margin-right: 0 !important;
      transform: none !important;
    }
    .slider-outer.is-desktop-grid.arrows-bottom {
      padding-bottom: 0 !important;
    }
    .slider-outer.is-desktop-grid .swipwer--btn,
    .slider-outer.is-desktop-grid .swiper-button-previ,
    .slider-outer.is-desktop-grid .swiper-button-nexts,
    .slider-outer.is-desktop-grid .pagination-container,
    .slider-outer.is-desktop-grid .swiper-pagination {
      display: none !important;
    }
  }

  /* Desktop Swiper Layout */
  @media (min-width: 1025px) {
    .customer-reviews-section .new-swiper-container[data-desktop-slider="true"] .swiper-wrapper {
      display: flex !important;
      flex-wrap: nowrap !important;
    }
    .customer-reviews-section .new-swiper-container[data-desktop-slider="true"] .swiper-slide {
      height: auto !important;
      display: flex !important;
      flex-shrink: 0 !important;
    }
  }

  /* Grid Layout (Laptop/Tablet fallback when slider is disabled) */
  @media (min-width: 769px) and (max-width: 1024px) {
    .customer-reviews__container.laptop-grid:not(.swiper-wrapper) {
      display: grid !important;
      grid-template-columns: repeat(var(--laptop-columns, 2), 1fr) !important;
      column-gap: var(--desktop-col-gap, 24px) !important;
      row-gap: var(--desktop-row-gap, 24px) !important;
      width: 100% !important;
      transform: none !important;
    }
    .customer-reviews__container.laptop-grid:not(.swiper-wrapper) .swiper-slide,
    .customer-reviews__container.laptop-grid:not(.swiper-wrapper) .customer-reviews__slide {
      width: auto !important;
      margin-right: 0 !important;
    }
  }

  /* Grid Layout (Mobile fallback when slider is disabled) */
  @media (max-width: 768px) {
    .customer-reviews__container.mobile-grid:not(.swiper-wrapper) {
      display: grid !important;
      grid-template-columns: repeat(var(--mobile-columns, 1), 1fr) !important;
      column-gap: var(--mobile-col-gap, 16px) !important;
      row-gap: var(--mobile-row-gap, 16px) !important;
      width: 100% !important;
      transform: none !important;
    }
    .customer-reviews__container.mobile-grid:not(.swiper-wrapper) .swiper-slide,
    .customer-reviews__container.mobile-grid:not(.swiper-wrapper) .customer-reviews__slide {
      width: auto !important;
      margin-right: 0 !important;
    }
  }

  /* Mobile & Tablet Swiper Layout */
  @media (max-width: 1024px) {
    .customer-reviews-section .new-swiper-container[data-mobile-slider="true"] .swiper-wrapper,
    .customer-reviews-section .new-swiper-container[data-tablet-slider="true"] .swiper-wrapper {
      display: flex !important;
      flex-wrap: nowrap !important;
    }
    .customer-reviews-section .new-swiper-container[data-mobile-slider="true"] .swiper-slide,
    .customer-reviews-section .new-swiper-container[data-tablet-slider="true"] .swiper-slide {
      height: auto !important;
      display: flex !important;
      flex-shrink: 0 !important;
    }
    .slider-outer.is-mobile-slider .swipwer--btn,
    .slider-outer.is-mobile-slider .swiper-button-previ,
    .slider-outer.is-mobile-slider .swiper-button-nexts {
      display: flex !important;
    }
    .slider-outer.is-mobile-slider .pagination-container,
    .slider-outer.is-mobile-slider .swiper-pagination {
      display: flex !important;
    }
  }

  .customer-reviews__slide {
    height: auto;
    display: flex;
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
  }

  /* Card */
  .customer-reviews__card {
    background-color: var(--reviews-card-bg);
    border-radius: var(--reviews-card-radius);
    border: 1px solid var(--reviews-card-border);
    padding: 30px 28px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    width: 100%;
    min-width: 0;
    min-height: 190px;
    box-sizing: border-box;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    overflow: hidden;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  {%- if section.settings.card_hover_lift -%}
  .customer-reviews__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.08);
  }
  {%- endif -%}

  @media (max-width: 767px) {
    .customer-reviews__card {
      padding: 24px 22px;
      min-height: 175px;
    }
  }

  /* Stars */
  .customer-reviews__stars {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 16px;
  }

  .customer-reviews__star {
    width: 17px;
    height: 17px;
  }

  .customer-reviews__star--filled {
    color: var(--reviews-star-color);
  }

  .customer-reviews__star--empty {
    color: #e5e0d8;
  }

  /* Quote */
  .customer-reviews__quote {
    font-size: var(--reviews-quote-size);
    line-height: 1.5;
    color: var(--reviews-quote-color);
    margin: 0 0 18px;
    flex-grow: 1;
    font-style: normal;
    font-weight: 450;
  }

  /* Author */
  .customer-reviews__author {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--reviews-author-color);
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.01em;
  }

  .customer-reviews__author-dash {
    opacity: 0.6;
  }

  .customer-reviews__verified-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    color: #16a34a;
  }

  .customer-reviews__verified-badge svg {
    width: 100%;
    height: 100%;
  }

  /* Swiper Button Styling */
  .customer-reviews-section .swipwer--btn {
    background-color: var(--primary, #d32f2f) !important;
    color: #fff !important;
    box-shadow: 0 4px 14px rgba(211, 47, 47, 0.28);
    border: none;
    border-radius: 50%;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s, background-color 0.2s, box-shadow 0.2s;
    z-index: 10;
  }
  .customer-reviews-section .swipwer--btn:hover {
    background-color: #b71c1c !important;
    transform: scale(1.1);
    box-shadow: 0 6px 18px rgba(211, 47, 47, 0.38);
  }
  .customer-reviews-section .swipwer--btn svg {
    width: 14px;
    height: 14px;
  }
  .customer-reviews-section .swipwer--btn svg path {
    fill: #ffffff !important;
    stroke: #ffffff !important;
  }
  .customer-reviews-section .swipwer--btn[aria-disabled="true"] {
    background-color: #f1f1f1 !important;
    opacity: 0.45;
    cursor: not-allowed;
  }
  .customer-reviews-section .swipwer--btn[aria-disabled="true"] svg path {
    fill: #888888 !important;
    stroke: #888888 !important;
  }

  /* Disclaimer */
  .customer-reviews__disclaimer {
    margin-top: 26px;
    text-align: center;
    font-size: 12px;
    line-height: 1.4;
    color: var(--reviews-disclaimer-color);
  }

  .customer-reviews__disclaimer p {
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "section",
  "class": "customer-reviews-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Headings & Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading (Eyebrow)",
      "default": "A PREVIEW OF HAPPY MOMENTS"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Main heading",
      "default": "The sweet word is out."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (Desktop)",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (Mobile)",
      "min": 20,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Optional description text"
    },
    {
      "type": "header",
      "content": "Disclaimer Note"
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show disclaimer below slider",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "disclaimer_text",
      "label": "Disclaimer text",
      "default": "Illustrative sample reviews for this storefront preview; not verified customer feedback."
    },
    {
      "type": "header",
      "content": "Layout Mode"
    },
    {
      "type": "select",
      "id": "layout_mode",
      "label": "Layout mode",
      "options": [
        {
          "value": "grid",
          "label": "Grid on desktop, Slider on mobile & tablet"
        },
        {
          "value": "slider",
          "label": "Completely Slider (carousel on all screens)"
        }
      ],
      "default": "slider",
      "info": "Switch between multi-row grid or continuous slider carousel"
    },
    {
      "type": "checkbox",
      "id": "enable_full_slider",
      "label": "Make completely slider",
      "default": true,
      "info": "Enable full carousel slider on both desktop and mobile/tablet"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
