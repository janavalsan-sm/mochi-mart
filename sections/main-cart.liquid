

{% liquid
  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

{% capture cart_page_more_blocks_content %}
  <div class="cart-page__more-blocks">
    {%- content_for 'blocks' -%}
  </div>
{% endcapture %}

{% capture cart_items_children %}
  <template id="empty-cart-template">
    <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
    <div
      class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
    >
      <div
        class="cart-page spacing-style cart-page--empty"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        <div class="cart-page__empty-box">
          <div class="cart-page__empty-emoji">🧸</div>
          <h2 class="cart-page__empty-title">Your cart is feeling a bit light!</h2>
          <p class="cart-page__empty-subtitle">Explore our cute stationery, plush pals, and little treats to fill it up.</p>
          <a
            class="cart-page__start-shopping-btn"
            href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
          >
            <span>Start Shopping →</span>
          </a>
        </div>
        {{ cart_page_more_blocks_content }}
      </div>
    </div>
  </template>

  <div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
  <div
    class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}"
  >
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      {%- if cart.empty? -%}
        <div class="cart-page__empty-box">
          <div class="cart-page__empty-emoji">🧸</div>
          <h2 class="cart-page__empty-title">Your cart is feeling a bit light!</h2>
          <p class="cart-page__empty-subtitle">Explore our cute stationery, plush pals, and little treats to fill it up.</p>
          <a
            class="cart-page__start-shopping-btn"
            href="{{ settings.empty_cart_button_link | default: routes.all_products_collection_url }}"
          >
            <span>Start Shopping →</span>
          </a>
        </div>
      {%- else -%}
        <div class="cart-page__main">
          <div class="cart-page__title">
            {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' %}
          </div>

          <div class="cart-page__items">
            {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}
          </div>
        </div>

        <div class="cart-page__summary">
          {%- content_for 'block', id: 'cart-page-summary', type: '_cart-summary' -%}
        </div>
      {%- endif -%}

      {{ cart_page_more_blocks_content }}
    </div>
  </div>
{% endcapture %}
{% render 'cart-items-component', children: cart_items_children, section_id: section.id %}

{% stylesheet %}
  .cart-page {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
    padding-top: clamp(20px, 3vw, 36px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: clamp(20px, 4vw, 40px);
  }

  .cart-page__main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
  }

  .cart-page__summary {
    width: 100%;
    min-width: 0;
    padding-top: 0;
  }

  @media screen and (min-width: 990px) {
    .cart-page:not(.cart-page--empty) {
      grid-template-columns: 1fr 380px;
      gap: 36px;
      align-items: start;
    }

    .cart-page__summary {
      position: sticky;
      top: 24px;
    }
  }

  @media screen and (min-width: 1200px) {
    .cart-page:not(.cart-page--empty) {
      grid-template-columns: 1fr 420px;
      gap: 40px;
      align-items: start;
    }
  }

  /* Cart Header */
  .cart-page__header-wrap {
    margin-bottom: 20px;
  }

  .cart-page__heading {
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: clamp(26px, 3.5vw, 36px) !important;
    font-weight: 700 !important;
    color: #2C1E19 !important;
    margin: 0 0 6px 0 !important;
    letter-spacing: -0.01em !important;
    display: inline-flex !important;
    align-items: baseline !important;
    gap: 10px !important;
  }

  .cart-page__item-count-badge {
    color: #DC2626 !important;
    font-size: 0.65em !important;
    font-weight: 600 !important;
  }

  .cart-page__subheading {
    font-family: 'DM Sans', sans-serif !important;
    font-size: 15px !important;
    color: #6F5D57 !important;
    margin: 0 !important;
  }


  /* Items Container Card */
  .cart-page:not(.cart-page--empty) .cart-items__wrapper {
    background: #FFFFFF;
    border-radius: 28px;
    padding: clamp(20px, 3vw, 32px);
    border: 1.5px solid rgba(44, 30, 25, 0.08);
    box-shadow: 0 8px 28px -12px rgba(60, 40, 30, 0.08);
    box-sizing: border-box;
  }

  .cart-page:not(.cart-page--empty) .cart-items__table {
    display: block;
    width: 100%;
  }

  .cart-page:not(.cart-page--empty) .cart-items__table tbody {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .cart-page:not(.cart-page--empty) .cart-items__table-row {
    display: grid !important;
    grid-template-columns: 96px minmax(0, 1fr) auto !important;
    grid-template-areas:
      "media details price"
      "media quantity price"
      "media error error" !important;
    column-gap: 20px !important;
    row-gap: 8px !important;
    align-items: center !important;
    padding: 0 0 24px 0 !important;
    margin: 0 0 24px 0 !important;
    border: none !important;
    border-bottom: 1px dashed rgba(44, 30, 25, 0.12) !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  .cart-page:not(.cart-page--empty) .cart-items__table-row:last-child {
    border-bottom: none !important;
    margin-bottom: 0 !important;
    padding-bottom: 4px !important;
  }

  .cart-page .cart-items__media {
    grid-area: media !important;
    width: 96px !important;
    height: 96px !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .cart-page .cart-items__media-container {
    width: 96px !important;
    height: 96px !important;
    min-width: 96px !important;
    min-height: 96px !important;
    border-radius: 20px !important;
    overflow: hidden !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    aspect-ratio: 1 / 1 !important;
    border: none !important;
    box-shadow: none !important;
  }

  .cart-page .cart-items__media-image {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 20px !important;
    border: none !important;
  }

  .cart-page .cart-items__details {
    grid-area: details !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .cart-page .cart-items__title {
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: 17px !important;
    font-weight: 600 !important;
    color: #2C1E19 !important;
    line-height: 1.35 !important;
    text-decoration: none !important;
    transition: color 0.15s ease !important;
  }

  .cart-page .cart-items__title:hover {
    color: #DC2626 !important;
  }

  .cart-page .cart-items__variants-wrapper {
    font-family: 'DM Sans', sans-serif !important;
    font-size: 13.5px !important;
    color: #6F5D57 !important;
  }

  .cart-page .cart-items__unit-price-wrapper {
    font-family: 'Fredoka', sans-serif !important;
    font-size: 15.5px !important;
    font-weight: 600 !important;
    color: #2C1E19 !important;
  }

  .cart-page .cart-items__quantity {
    grid-area: quantity !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    align-items: center !important;
  }

  .cart-page .cart-items__quantity-controls {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
    margin: 0 !important;
  }

  .cart-page cart-quantity-selector-component,
  .cart-page .quantity-selector {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background-color: #FFFFFF !important;
    border: 1.5px solid #E7E2DB !important;
    border-radius: 100px !important;
    height: 36px !important;
    padding: 0 4px !important;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04) !important;
  }

  .cart-page cart-quantity-selector-component button,
  .cart-page .quantity-selector button {
    width: 28px !important;
    height: 28px !important;
    min-width: 28px !important;
    border: none !important;
    background: transparent !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    color: #443E39 !important;
    padding: 0 !important;
    border-radius: 50% !important;
    transition: background-color 0.15s ease, color 0.15s ease !important;
  }

  .cart-page cart-quantity-selector-component button:hover,
  .cart-page .quantity-selector button:hover {
    background-color: #FFE5E3 !important;
    color: #DC2626 !important;
  }

  .cart-page cart-quantity-selector-component input,
  .cart-page .quantity-selector input {
    width: 32px !important;
    height: 100% !important;
    border: none !important;
    background: transparent !important;
    text-align: center !important;
    font-family: 'Fredoka', sans-serif !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    color: #2C1E19 !important;
    padding: 0 !important;
    margin: 0 !important;
    -moz-appearance: textfield !important;
  }

  .cart-page .cart-items__remove {
    background: transparent !important;
    border: none !important;
    color: #8A837C !important;
    width: 34px !important;
    height: 34px !important;
    min-width: 34px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    cursor: pointer !important;
    border-radius: 50% !important;
    transition: all 0.2s ease !important;
  }

  .cart-page .cart-items__remove:hover {
    color: #DC2626 !important;
    background-color: #FFE5E3 !important;
    transform: scale(1.08) !important;
  }

  .cart-page .cart-items__price {
    grid-area: price !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    color: #2C1E19 !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Cart Summary Card */
  .cart-page .cart-summary {
    background: #FFFFFF !important;
    border-radius: 28px !important;
    padding: clamp(24px, 3vw, 32px) !important;
    border: 1.5px solid rgba(44, 30, 25, 0.08) !important;
    box-shadow: 0 8px 30px -10px rgba(60, 40, 30, 0.08) !important;
    box-sizing: border-box !important;
  }

  .cart-page .cart-summary__inner {
    width: 100% !important;
    gap: 20px !important;
  }

  /* Discount Code Box in Summary */
  .cart-page .cart-actions {
    border: none !important;
    border-top: 1px solid rgba(44, 30, 25, 0.08) !important;
    border-bottom: 1px solid rgba(44, 30, 25, 0.08) !important;
    padding: 14px 0 !important;
    margin: 0 !important;
    width: 100% !important;
  }

  .cart-page .cart-discount {
    width: 100% !important;
  }

  .cart-page .cart-discount__summary {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    cursor: pointer !important;
    padding: 2px 0 !important;
  }

  .cart-page .cart-discount__label {
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: 15px !important;
    font-weight: 600 !important;
    color: #2C1E19 !important;
  }

  .cart-page .cart-totals__icon {
    width: 14px !important;
    height: 14px !important;
    color: #8A837C !important;
    transition: transform 0.2s ease !important;
  }

  .cart-page details.cart-discount[open] .cart-totals__icon {
    transform: rotate(45deg) !important;
  }

  .cart-page .cart-discount__content {
    height: auto !important;
  }

  .cart-page .cart-discount__form {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-top: 12px !important;
    padding: 0 !important;
    height: auto !important;
    width: 100% !important;
  }

  .cart-page .cart-discount__input {
    flex: 1 1 auto !important;
    height: 42px !important;
    background-color: #FAF7F4 !important;
    color: #2C1E19 !important;
    border: 1.5px solid rgba(44, 30, 25, 0.12) !important;
    border-radius: 12px !important;
    padding: 0 14px !important;
    font-family: 'DM Sans', sans-serif !important;
    font-size: 13.5px !important;
    font-weight: 500 !important;
    outline: none !important;
    box-sizing: border-box !important;
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease !important;
  }

  .cart-page .cart-discount__input:focus {
    border-color: #DC2626 !important;
    background-color: #FFFFFF !important;
    box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1) !important;
  }

  .cart-page .cart-discount__input::placeholder {
    color: #9E948F !important;
    font-weight: 400 !important;
  }

  .cart-page .cart-discount__button {
    flex-shrink: 0 !important;
    height: 42px !important;
    padding: 0 20px !important;
    background-color: #2C1E19 !important;
    color: #FFFFFF !important;
    border: none !important;
    border-radius: 12px !important;
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.2s ease !important;
    box-shadow: 0 2px 8px rgba(44, 30, 25, 0.1) !important;
  }

  .cart-page .cart-discount__button:hover {
    background-color: #DC2626 !important;
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25) !important;
    transform: translateY(-1px) !important;
  }

  .cart-page .cart-discount__pill {
    background-color: #FFE5E3 !important;
    color: #DC2626 !important;
    border: 1px solid rgba(220, 38, 38, 0.2) !important;
    border-radius: 100px !important;
    padding: 4px 12px !important;
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: 13px !important;
    font-weight: 600 !important;
  }

  /* Estimated Total Row - Clean & Uncongested */
  .cart-page .cart-totals {
    width: 100% !important;
    gap: 16px !important;
  }

  .cart-page .cart-totals__container {
    width: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
  }

  .cart-page .cart-totals__total {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    width: 100% !important;
    margin-bottom: 2px !important;
    flex-wrap: nowrap !important;
    gap: 12px !important;
  }

  .cart-page .cart-totals__total-label {
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: 18px !important;
    font-weight: 600 !important;
    color: #2C1E19 !important;
    white-space: nowrap !important;
    letter-spacing: -0.01em !important;
    flex-shrink: 0 !important;
  }

  .cart-page .cart-totals__total-value {
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: 20px !important;
    font-weight: 700 !important;
    color: #2C1E19 !important;
    white-space: nowrap !important;
    text-align: right !important;
    flex-shrink: 0 !important;
  }

  .cart-page .cart-totals__tax-note,
  .cart-page .cart-totals__tax-note p,
  .cart-page .cart-totals__tax-note small {
    font-family: 'DM Sans', sans-serif !important;
    font-size: 13px !important;
    line-height: 1.45 !important;
    color: #7E726D !important;
    margin: 4px 0 16px 0 !important;
  }

  .cart-page .cart__checkout-button {
    background-color: #DC2626 !important;
    color: #FFFFFF !important;
    border-radius: 100px !important;
    border: none !important;
    padding: 18px 28px !important;
    width: 100% !important;
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: 16.5px !important;
    font-weight: 600 !important;
    letter-spacing: 0.02em !important;
    cursor: pointer !important;
    box-shadow: 0 4px 16px rgba(220, 38, 38, 0.28) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease !important;
  }

  .cart-page .cart__checkout-button:hover {
    background-color: #B91C1C !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 22px rgba(220, 38, 38, 0.38) !important;
  }

  /* Trust Perks Box */
  .cart-page__trust-badges {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px dashed rgba(44, 30, 25, 0.12);
  }

  .cart-page__trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    color: #6F5D57;
  }

  .cart-page__trust-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: #FFE5E3;
    color: #DC2626;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    flex-shrink: 0;
  }

  /* Empty State */
  .cart-page__empty-box {
    background: #FFFFFF;
    border-radius: 32px;
    padding: clamp(48px, 6vw, 72px) clamp(24px, 4vw, 48px);
    text-align: center;
    border: 1.5px solid rgba(44, 30, 25, 0.08);
    box-shadow: 0 8px 30px -10px rgba(60, 40, 30, 0.08);
    max-width: 540px;
    margin: 40px auto;
  }

  .cart-page__empty-emoji {
    font-size: 64px;
    line-height: 1;
    margin-bottom: 20px;
  }

  .cart-page__empty-title {
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: clamp(24px, 3vw, 30px) !important;
    font-weight: 700 !important;
    color: #2C1E19 !important;
    margin: 0 0 10px 0 !important;
  }

  .cart-page__empty-subtitle {
    font-family: 'DM Sans', sans-serif !important;
    font-size: 15px !important;
    color: #6F5D57 !important;
    margin: 0 0 28px 0 !important;
    line-height: 1.5 !important;
  }

  .cart-page__start-shopping-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background-color: #DC2626 !important;
    color: #FFFFFF !important;
    border-radius: 100px !important;
    padding: 16px 36px !important;
    font-family: 'Fredoka', 'DM Sans', sans-serif !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    box-shadow: 0 4px 16px rgba(220, 38, 38, 0.28) !important;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease !important;
  }

  .cart-page__start-shopping-btn:hover {
    background-color: #B91C1C !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 22px rgba(220, 38, 38, 0.38) !important;
  }

  /* Mobile responsiveness */
  @media screen and (max-width: 749px) {
    .cart-page:not(.cart-page--empty) .cart-items__table-row {
      grid-template-columns: 80px minmax(0, 1fr) !important;
      grid-template-areas:
        "media details"
        "media price"
        "media quantity"
        "error error" !important;
      column-gap: 14px !important;
      row-gap: 8px !important;
      padding-bottom: 20px !important;
      margin-bottom: 20px !important;
    }

    .cart-page .cart-items__media {
      width: 80px !important;
      height: 80px !important;
    }

    .cart-page .cart-items__media-container {
      width: 80px !important;
      height: 80px !important;
      min-width: 80px !important;
      min-height: 80px !important;
      border-radius: 16px !important;
    }

    .cart-page .cart-items__price {
      justify-content: flex-start !important;
      font-size: 16.5px !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
